import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon } from "theme.slint";

export enum Tone { neutral, ok, warn, danger, accent }

// A rounded status label: "valid", "expired", "secret key".
export component Pill inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.neutral;
    in property <image> glyph;

    property <brush> ink:
        root.tone == Tone.ok ? Theme.ok
        : root.tone == Tone.warn ? Theme.warn
        : root.tone == Tone.danger ? Theme.danger
        : root.tone == Tone.accent ? Theme.accent
        : Theme.text-dim;
    property <brush> wash:
        root.tone == Tone.ok ? Theme.ok-soft
        : root.tone == Tone.warn ? Theme.warn-soft
        : root.tone == Tone.danger ? Theme.danger-soft
        : root.tone == Tone.accent ? Theme.accent-soft
        : Theme.hover;

    height: 20px;
    background: root.wash;
    border-radius: 10px;
    horizontal-stretch: 0;

    HorizontalLayout {
        padding-left: root.glyph.width == 0 ? 8px : 6px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;

        if root.glyph.width > 0: Icon {
            glyph: root.glyph;
            tint: root.ink;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: root.ink;
            font-size: Theme.t-xs;
            font-weight: Theme.w-medium;
            vertical-alignment: center;
        }
    }
}

export enum Variant { primary, secondary, ghost, danger }

export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> glyph;
    in property <Variant> variant: Variant.secondary;
    in property <bool> enabled: true;
    /// Fills its container and left-aligns, for buttons used as navigation
    /// rather than as a compact action.
    in property <bool> wide: false;
    /// Drop the label and show the glyph alone, for a row too narrow to spell
    /// every action out. `text` is still what assistive technology announces,
    /// so a compact button is unlabelled only on screen.
    in property <bool> compact: false;
    /// What assistive technology should call this. Needed only where `text` is
    /// empty — an icon-only button announces as nothing otherwise, and several
    /// of those are destructive.
    in property <string> label;
    callback clicked();

    // A screen reader needs three things here, and the app used to supply
    // none of them: what this is, what it is called, and how to press it.
    // (Slint labels the Text *inside* a button automatically, so the name
    // often leaked through by accident — but never the role or the action,
    // and never anything at all for an icon-only button.)
    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    property <bool> filled: root.variant == Variant.primary || root.variant == Variant.danger;
    property <brush> fill-base: root.variant == Variant.danger ? Theme.danger : Theme.accent;
    property <brush> ink:
        root.filled ? Theme.accent-ink
        : root.variant == Variant.danger ? Theme.danger
        : Theme.text;

    height: 32px;
    horizontal-stretch: 0;
    // Never narrower than what is inside it. This was `0px` for a labelled
    // button, which let a cramped layout shrink the rectangle to nothing while
    // the Text kept its natural width — so the label spilled out of its own
    // button and across its neighbours instead of the row simply running out
    // of space. An icon-only button has no text to measure, hence the floor.
    min-width: root.text == "" || root.compact ? 32px : content.preferred-width;
    border-radius: Theme.r-sm;
    opacity: root.enabled ? 1.0 : 0.4;

    background: !root.enabled ? (root.filled ? root.fill-base : transparent)
        : root.filled
            ? (touch.pressed ? Theme.accent-hover : (touch.has-hover ? Theme.accent-hover : root.fill-base))
            : (touch.pressed ? Theme.pressed : (touch.has-hover ? Theme.hover : transparent));

    border-width: root.variant == Variant.secondary ? 1px : 0px;
    border-color: Theme.border-strong;

    animate background { duration: Theme.fast; }

    // A glyph does not fill its 16px box: the artwork is drawn inside a
    // 24-unit canvas that leaves a margin, so the ink starts short of where
    // the padding puts the box. Equal padding therefore reads as contents
    // pushed to the right, which is what it looked like. Trim the leading
    // padding by that margin so the *ink* is centred rather than the boxes.
    //
    // Not applied to a wide button: those left-align against a shared edge
    // with their neighbours, and shifting one of them breaks the column.
    property <length> lead-trim: root.wide || root.glyph.width <= 0 ? 0px : 1px;

    property <bool> bare: root.text == "" || root.compact;

    content := HorizontalLayout {
        padding-left: root.bare ? 0px : Theme.s3 - root.lead-trim;
        padding-right: root.bare ? 0px : Theme.s3;
        spacing: 6px;
        alignment: root.wide ? start : center;

        if root.glyph.width > 0: Icon {
            glyph: root.glyph;
            tint: root.ink;
            y: (parent.height - self.height) / 2;
        }

        if !root.bare: Text {
            text: root.text;
            color: root.ink;
            font-size: Theme.t-md;
            font-weight: Theme.w-medium;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    // Reachable by keyboard, not only by pointer. Space and Enter are what a
    // button is expected to answer to, and the ring is what tells a sighted
    // keyboard user where they are — without it, tabbing moves an invisible
    // cursor around the window.
    key := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if key.has-focus: Rectangle {
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: root.border-radius + 1px;
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
    }
}

// Single-line text entry. Built on the TextInput primitive rather than
// std-widgets' LineEdit so that focus, placeholder and password masking all
// follow the app's own palette instead of the platform style's.
//
// Nothing here sits in a layout. A TextInput reports its content size as a
// minimum and a layout honours a minimum over the space it was given, so a
// TextInput inside a HorizontalLayout widens its box as you type and shoves
// its neighbours aside. Setting `min-width: 0` does not help — the intrinsic
// layout info wins. Positioning against this element's own size is what keeps
// the box the size the caller asked for.
export component Field inherits Rectangle {
    in property <string> placeholder;
    in property <bool> secret: false;
    in property <bool> enabled: true;
    in property <image> glyph;
    in-out property <string> text <=> input.text;
    callback edited(string);
    callback accepted();

    property <length> text-x: root.glyph.width > 0
        ? Theme.s3 + 16px + Theme.s2
        : Theme.s3;

    height: 34px;
    min-width: 0px;
    clip: true;
    background: Theme.surface-sunken;
    border-radius: Theme.r-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1.0 : 0.5;

    animate border-color { duration: Theme.fast; }

    if root.glyph.width > 0: Icon {
        glyph: root.glyph;
        tint: Theme.text-faint;
        x: Theme.s3;
        y: (root.height - self.height) / 2;
    }

    input := TextInput {
        x: root.text-x;
        y: 0;
        width: root.width - root.text-x - Theme.s3;
        height: root.height;
        vertical-alignment: center;
        color: Theme.text;
        font-size: Theme.t-md;
        single-line: true;
        read-only: !root.enabled;
        input-type: root.secret ? InputType.password : InputType.text;
        // input-type only masks the glyphs on screen. Slint's accessibility
        // pass binds accessible-value to `text` for every TextInput with no
        // exception for password fields, and AccessKit publishes that
        // verbatim to AT-SPI and NSAccessibility, so a passphrase would go
        // out in cleartext to anything watching the bus. Binding it here
        // pre-empts that pass, which only fills in what is not already set.
        // tests/accessibility.rs holds this shut.
        accessible-value: root.secret ? "" : self.text;
        // The pass sets no accessible-label for a TextInput, so a secret
        // field would otherwise be announced with neither name nor value.
        accessible-label: root.placeholder;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.accent-ink;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }

    if input.text == "": Text {
        x: root.text-x;
        y: 0;
        width: root.width - root.text-x - Theme.s3;
        height: root.height;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: Theme.t-md;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component Check inherits Rectangle {
    in property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback toggled();

    // Checked state is the whole point of a checkbox and the one thing a
    // screen reader cannot infer from the drawing.
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }

    height: 24px;
    // Without this a Check in a row layout expands to an equal share of the
    // width, which spreads two adjacent options to opposite ends of the dialog.
    horizontal-stretch: 0;
    opacity: root.enabled ? 1.0 : 0.45;

    HorizontalLayout {
        spacing: Theme.s2;
        alignment: start;

        Rectangle {
            width: 17px;
            height: 17px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: root.checked ? Theme.accent : Theme.surface-sunken;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.border-strong;
            animate background { duration: Theme.fast; }

            if root.checked: Icon {
                glyph: Icons.check;
                tint: Theme.accent-ink;
                width: 12px;
                height: 12px;
            }
        }

        if root.text != "": Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.t-md;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }

    key := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }

    if key.has-focus: Rectangle {
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: 6px;
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
    }
}

// A dropdown. std-widgets' ComboBox would be the platform style's, so this is
// a plain button plus a PopupWindow.
export component Select inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current: 0;
    /// Names the choice being made. The chosen option is the value; without a
    /// label a screen reader can say "RFC 9580" but not what it is *for*.
    in property <string> label;
    callback changed(int);

    accessible-role: combobox;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-value: root.current >= 0 && root.current < root.model.length
        ? root.model[root.current]
        : "";
    accessible-action-default => { popup.show(); }

    height: 34px;
    background: Theme.surface-sunken;
    border-radius: Theme.r-sm;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-strong : Theme.border;
    opacity: root.enabled ? 1.0 : 0.5;

    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s2;
        spacing: Theme.s2;

        Text {
            text: root.current >= 0 && root.current < root.model.length
                ? root.model[root.current]
                : "";
            color: Theme.text;
            font-size: Theme.t-md;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Icon {
            glyph: Icons.chevron-down;
            tint: Theme.text-faint;
            y: (parent.height - self.height) / 2;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { popup.show(); }
    }

    key := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                popup.show();
                return accept;
            }
            // Up and down move through the options without opening the list,
            // which is what a combobox is expected to do.
            if (event.text == Key.DownArrow && root.current + 1 < root.model.length) {
                root.current += 1;
                root.changed(root.current);
                return accept;
            }
            if (event.text == Key.UpArrow && root.current > 0) {
                root.current -= 1;
                root.changed(root.current);
                return accept;
            }
            return reject;
        }
    }

    if key.has-focus: Rectangle {
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: root.border-radius + 1px;
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(240px, root.model.length * 30px + 2 * Theme.s1);

        Rectangle {
            background: Theme.surface;
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: Theme.s1;

                for label[index] in root.model: Rectangle {
                    height: 30px;
                    border-radius: Theme.r-sm;
                    background: option.has-hover ? Theme.hover
                        : (index == root.current ? Theme.selected : transparent);

                    HorizontalLayout {
                        padding-left: Theme.s2;
                        padding-right: Theme.s2;
                        Text {
                            text: label;
                            color: Theme.text;
                            font-size: Theme.t-md;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    option := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.current = index;
                            root.changed(index);
                        }
                    }
                }
            }
        }
    }
}

// Coloured initials standing in for a photo. The tint is chosen by the caller
// from a fingerprint hash, so a certificate keeps its colour between sessions.
export component Monogram inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    in property <length> size: 36px;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.tint.transparentize(0.85);
    horizontal-stretch: 0;

    Text {
        text: root.initials;
        color: root.tint;
        font-size: root.size * 0.36;
        font-weight: Theme.w-bold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component SectionLabel inherits Text {
    color: Theme.text-faint;
    font-size: Theme.t-xs;
    font-weight: Theme.w-bold;
    letter-spacing: 0.6px;
}

// Label on the left, value on the right, for the details pane.
export component FieldRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;
    /// Whether this row's value is worth copying. Off by default: an
    /// "Algorithm" or "Created" row does not need one, and a button on every
    /// row would be a column of them down the details pane.
    in property <bool> copyable: false;
    callback copy();

    /// Owned here rather than by the caller, so a row confirms itself and no
    /// usage site has to hold state for it.
    property <bool> copied: false;

    // A Rectangle tells its parent layout nothing about what is inside it, so
    // the row has to republish the inner layout's own sizing or every dialog
    // built from FieldRows measures short and pushes its buttons off the card.
    min-height: body.min-height;
    preferred-height: body.preferred-height;

    // The whole row is the target, not just the icon: an affordance you have
    // to find by sweeping the pointer around is not one.
    //
    // This is why the value is a Text rather than a read-only TextInput. An
    // input consumes pointer events, so it would both swallow the hover that
    // reveals the button and make a click ambiguous between starting a
    // selection and copying. Selecting part of a value by hand is the price;
    // copying the whole of it in one click is what people actually do with a
    // fingerprint.
    touch := TouchArea {
        enabled: root.copyable;
        mouse-cursor: root.copyable ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.copy();
            root.copied = true;
            settle.running = true;
        }

        settle := Timer {
            interval: 1600ms;
            running: false;
            triggered => {
                root.copied = false;
                self.running = false;
            }
        }

        body := HorizontalLayout {
            spacing: Theme.s3;
            alignment: start;

            Text {
                text: root.label;
                width: 92px;
                color: Theme.text-faint;
                font-size: Theme.t-sm;
                vertical-alignment: top;
            }

            // Two variants rather than a conditional font-family: leaving the
            // family unset is what lets the value inherit the platform's UI
            // font.
            if root.mono: Text {
                text: root.value;
                color: Theme.text;
                font-size: Theme.t-sm;
                font-family: "Source Code Pro";
                horizontal-stretch: 1;
                wrap: word-wrap;
            }

            if !root.mono: Text {
                text: root.value;
                color: Theme.text;
                font-size: Theme.t-md;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }

            if root.copyable: Rectangle {
                // The copy affordance is this element, and it exists only when
                // the row is copyable — which is what lets accessible-role be
                // the constant Slint requires.
                accessible-role: button;
                accessible-label: "Copy " + root.label;
                accessible-description: root.value;
                accessible-action-default => {
                    root.copy();
                    root.copied = true;
                    settle.running = true;
                }
                width: 16px;
                Icon {
                    glyph: root.copied ? Icons.check : Icons.file;
                    tint: root.copied ? Theme.ok : Theme.text-faint;
                    width: 14px;
                    height: 14px;
                    y: 2px;
                    // Kept lit while `copied` so the confirmation is not
                    // dismissed by the pointer moving away after the click.
                    opacity: root.copied ? 1.0 : (touch.has-hover ? 1.0 : 0.0);
                    animate opacity { duration: Theme.fast; }
                }
            }
        }
    }
}

export component DialogShell inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <length> card-width: 460px;
    callback dismissed();

    background: Theme.scrim;

    // Swallow clicks so the list behind stays inert, and close on Escape.
    TouchArea {
        clicked => { root.dismissed(); }
    }

    // The scope wraps the card rather than sitting beside it. Slint delivers a
    // key only along the focused item's ancestor chain, so as a sibling this
    // never saw Escape once a Field inside the card took focus — which is the
    // state a user is in immediately after typing a name or a passphrase, in
    // nine of the twelve dialogs. An explicit size is required: FocusScope
    // reports no layout info of its own, and a zero-sized scope would leave
    // the card centred against nothing and drawn off-screen.
    focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: root.card-width;
            // min() rather than max-height: setting both height and max-height is
            // a Slint warning, and the card must never outgrow the window.
            // s4, not s6: a 32px gutter top and bottom cost 64px of the window,
            // which on a short screen is the difference between a dialog fitting
            // and needing to be scrolled by one line.
            height: min(content.preferred-height, root.height - 2 * Theme.s4);
            // Belt and braces for the case a dialog's content still cannot fit:
            // clipped is recoverable, whereas controls drawn outside the card look
            // like a rendering fault.
            clip: true;
            background: Theme.surface;
            border-radius: Theme.r-lg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 48px;
            drop-shadow-color: #00000059;
            drop-shadow-offset-y: 16px;

            // Clicks inside the card must not reach the scrim behind it.
            TouchArea {}

            content := VerticalLayout {
                padding: Theme.s5;
                spacing: Theme.s4;

                VerticalLayout {
                    spacing: Theme.s1;
                    // Conditional like the subtitle below, so a dialog that draws
                    // its own heading — About, with the wordmark — does not get an
                    // empty line above it.
                    if root.title != "": Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: Theme.t-xl;
                        font-weight: Theme.w-bold;
                    }
                    if root.subtitle != "": Text {
                        text: root.subtitle;
                        color: Theme.text-dim;
                        font-size: Theme.t-md;
                        wrap: word-wrap;
                    }
                }

                @children
            }
        }

        init => { focus.focus(); }
    }
}

/// Multi-line text entry, for the notepad.
///
/// The input is sized from *this* element rather than from the ScrollView it
/// sits in. Taking the width from the viewport closes a binding loop — the
/// viewport sizes from its content and the content from the viewport — and
/// letting the input drive its own height makes the box grow as you type,
/// because a TextInput reports its content height as a minimum and a layout
/// honours a minimum over an explicit height.
export component TextArea inherits Rectangle {
    in property <string> placeholder;
    in property <bool> enabled: true;
    in-out property <string> text <=> input.text;
    callback edited(string);

    background: Theme.surface-sunken;
    border-radius: Theme.r-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    clip: true;
    // Stops the inner text from pushing the box outwards as it grows.
    min-height: 0px;
    max-height: root.height;

    scroll := ScrollView {
        x: Theme.s3;
        y: Theme.s3;
        width: root.width - 2 * Theme.s3;
        height: root.height - 2 * Theme.s3;
        viewport-width: self.visible-width;
        // Without a viewport taller than the visible area the ScrollView has
        // nothing to scroll and shows no scrollbar.
        viewport-height: max(self.visible-height, input.preferred-height);

        input := TextInput {
            width: scroll.visible-width;
            color: Theme.text;
            font-size: Theme.t-md;
            font-family: "Source Code Pro";
            single-line: false;
            wrap: word-wrap;
            read-only: !root.enabled;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.accent-ink;
            edited => { root.edited(self.text); }
        }
    }

    if input.text == "": Text {
        x: Theme.s3;
        y: Theme.s3;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: Theme.t-md;
    }
}
