import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon } from "theme.slint";
import { CertRow } from "types.slint";

export enum Tone { neutral, ok, warn, danger, accent }

// A rounded status label: "valid", "expired", "secret key".
export component Pill inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.neutral;
    in property <image> glyph;

    property <brush> ink:
        root.tone == Tone.ok ? Theme.ok
        : root.tone == Tone.warn ? Theme.warn
        : root.tone == Tone.danger ? Theme.danger
        : root.tone == Tone.accent ? Theme.accent
        : Theme.text-dim;
    property <brush> wash:
        root.tone == Tone.ok ? Theme.ok-soft
        : root.tone == Tone.warn ? Theme.warn-soft
        : root.tone == Tone.danger ? Theme.danger-soft
        : root.tone == Tone.accent ? Theme.accent-soft
        : Theme.hover;

    height: 20px;
    background: root.wash;
    border-radius: 10px;
    horizontal-stretch: 0;

    HorizontalLayout {
        padding-left: root.glyph.width == 0 ? 8px : 6px;
        padding-right: 8px;
        spacing: 4px;
        alignment: center;

        if root.glyph.width > 0: Icon {
            glyph: root.glyph;
            tint: root.ink;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: root.ink;
            font-size: Theme.t-xs;
            font-weight: Theme.w-medium;
            vertical-alignment: center;
        }
    }
}

export enum Variant { primary, secondary, ghost, danger }

export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> glyph;
    in property <Variant> variant: Variant.secondary;
    in property <bool> enabled: true;
    /// Fills its container and left-aligns, for buttons used as navigation
    /// rather than as a compact action.
    in property <bool> wide: false;
    /// Drop the label and show the glyph alone, for a row too narrow to spell
    /// every action out. `text` is still what assistive technology announces,
    /// so a compact button is unlabelled only on screen.
    in property <bool> compact: false;
    /// What assistive technology should call this. Needed only where `text` is
    /// empty — an icon-only button announces as nothing otherwise, and several
    /// of those are destructive.
    in property <string> label;
    callback clicked();

    // A screen reader needs three things here, and the app used to supply
    // none of them: what this is, what it is called, and how to press it.
    // (Slint labels the Text *inside* a button automatically, so the name
    // often leaked through by accident — but never the role or the action,
    // and never anything at all for an icon-only button.)
    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-enabled: root.enabled;
    // `enabled` is checked here and in the key handler below because nothing
    // else checks it on their behalf, and a disabled button is the only thing
    // holding Delete shut until the key ID has been typed. Slint hands an
    // assistive-technology activation straight to this handler, and of the
    // AccessKit adapters only the Windows one refuses a control published as
    // disabled, so on Linux and macOS a screen reader could press a greyed-out
    // button. Keeping the FocusScope below from gaining focus does nothing
    // about one that had focus before the button was disabled: it goes on
    // receiving every key. The TouchArea is the one part that enforces
    // `enabled` by itself. Check, Select, FieldRow's copy button, the
    // certificate list and its scope tabs follow the same rule for the same
    // reasons.
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    property <bool> filled: root.variant == Variant.primary || root.variant == Variant.danger;
    property <brush> fill-base: root.variant == Variant.danger ? Theme.danger : Theme.accent;
    property <brush> ink:
        root.filled ? Theme.accent-ink
        : root.variant == Variant.danger ? Theme.danger
        : Theme.text;

    height: 32px;
    horizontal-stretch: 0;
    // Never narrower than what is inside it. This was `0px` for a labelled
    // button, which let a cramped layout shrink the rectangle to nothing while
    // the Text kept its natural width — so the label spilled out of its own
    // button and across its neighbours instead of the row simply running out
    // of space. An icon-only button has no text to measure, hence the floor.
    min-width: root.text == "" || root.compact ? 32px : content.preferred-width;
    border-radius: Theme.r-sm;
    opacity: root.enabled ? 1.0 : 0.4;

    background: !root.enabled ? (root.filled ? root.fill-base : transparent)
        : root.filled
            ? (touch.pressed ? Theme.accent-hover : (touch.has-hover ? Theme.accent-hover : root.fill-base))
            : (touch.pressed ? Theme.pressed : (touch.has-hover ? Theme.hover : transparent));

    border-width: root.variant == Variant.secondary ? 1px : 0px;
    border-color: Theme.border-strong;

    animate background { duration: Theme.fast; }

    // A glyph does not fill its 16px box: the artwork is drawn inside a
    // 24-unit canvas that leaves a margin, so the ink starts short of where
    // the padding puts the box. Equal padding therefore reads as contents
    // pushed to the right, which is what it looked like. Trim the leading
    // padding by that margin so the *ink* is centred rather than the boxes.
    //
    // Not applied to a wide button: those left-align against a shared edge
    // with their neighbours, and shifting one of them breaks the column.
    property <length> lead-trim: root.wide || root.glyph.width <= 0 ? 0px : 1px;

    property <bool> bare: root.text == "" || root.compact;

    content := HorizontalLayout {
        padding-left: root.bare ? 0px : Theme.s3 - root.lead-trim;
        padding-right: root.bare ? 0px : Theme.s3;
        spacing: 6px;
        alignment: root.wide ? start : center;

        if root.glyph.width > 0: Icon {
            glyph: root.glyph;
            tint: root.ink;
            y: (parent.height - self.height) / 2;
        }

        if !root.bare: Text {
            text: root.text;
            color: root.ink;
            font-size: Theme.t-md;
            font-weight: Theme.w-medium;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    // Reachable by keyboard, not only by pointer. Space and Enter are what a
    // button is expected to answer to, and the ring is what tells a sighted
    // keyboard user where they are — without it, tabbing moves an invisible
    // cursor around the window.
    //
    // A disabled button takes no focus from Tab, nor from assistive
    // technology's Focus action, which arrives as a click. The scope itself is
    // never disabled: a disabled FocusScope ignores being told that focus has
    // left it, so one disabled while it had focus kept `has-focus`, and drew
    // its ring, after focus had moved on. Opening a dialog does that to the
    // button that opened it, since the window disables everything behind an
    // open dialog, and the ring then stayed on it, and was still there when
    // the dialog closed. Check, Select, FieldRow's copy button, the
    // certificate list and its scope tabs do the same.
    key := FocusScope {
        width: 0px;
        focus-on-tab-navigation: root.enabled;
        focus-on-click: root.enabled;
        key-pressed(event) => {
            // Rejected rather than swallowed, so a disabled button is as if it
            // were not there. Nothing above it handles Space or Enter today.
            if (!root.enabled) {
                return reject;
            }
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if key.has-focus: ring := Rectangle {
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: root.border-radius + 1px;
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
    }
}

// Single-line text entry. Built on the TextInput primitive rather than
// std-widgets' LineEdit so that focus, placeholder and password masking all
// follow the app's own palette instead of the platform style's.
//
// Nothing here sits in a layout. A TextInput reports its content size as a
// minimum and a layout honours a minimum over the space it was given, so a
// TextInput inside a HorizontalLayout widens its box as you type and shoves
// its neighbours aside. Setting `min-width: 0` does not help — the intrinsic
// layout info wins. Positioning against this element's own size is what keeps
// the box the size the caller asked for.
export component Field inherits Rectangle {
    in property <string> placeholder;
    in property <bool> secret: false;
    in property <bool> enabled: true;
    in property <image> glyph;
    in-out property <string> text <=> input.text;
    callback edited(string);
    callback accepted();

    property <length> text-x: root.glyph.width > 0
        ? Theme.s3 + 16px + Theme.s2
        : Theme.s3;

    height: 34px;
    min-width: 0px;
    clip: true;
    background: Theme.surface-sunken;
    border-radius: Theme.r-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1.0 : 0.5;

    animate border-color { duration: Theme.fast; }

    if root.glyph.width > 0: Icon {
        glyph: root.glyph;
        tint: Theme.text-faint;
        x: Theme.s3;
        y: (root.height - self.height) / 2;
    }

    input := TextInput {
        x: root.text-x;
        y: 0;
        width: root.width - root.text-x - Theme.s3;
        height: root.height;
        vertical-alignment: center;
        color: Theme.text;
        font-size: Theme.t-md;
        single-line: true;
        read-only: !root.enabled;
        // Disabled as well as read-only, because read-only stops only typed
        // keys. An input method's composed text is inserted without looking
        // at it, and a field that had focus before it was disabled keeps its
        // input method switched on, which Slint's own FIXME admits. A disabled
        // TextInput ignores every key event, composed text included, and
        // cannot gain focus. No Field is shown only to be read, so nothing is
        // lost by the text no longer being selectable while it is disabled.
        enabled: root.enabled;
        input-type: root.secret ? InputType.password : InputType.text;
        // input-type only masks the glyphs on screen. Slint's accessibility
        // pass binds accessible-value to `text` for every TextInput with no
        // exception for password fields, and AccessKit publishes that
        // verbatim to AT-SPI and NSAccessibility, so a passphrase would go
        // out in cleartext to anything watching the bus. Binding it here
        // pre-empts that pass, which only fills in what is not already set.
        // tests/accessibility.rs holds this shut.
        accessible-value: root.secret ? "" : self.text;
        // The pass sets no accessible-label for a TextInput, so a secret
        // field would otherwise be announced with neither name nor value.
        accessible-label: root.placeholder;
        // The same pass also gives every TextInput a set-value action that
        // writes `text` and fires `edited` without looking at either flag.
        // Once the input is disabled the Windows adapter refuses it, but the
        // macOS one passes it on regardless, so this is that action with the
        // check it lacks.
        accessible-action-set-value(value) => {
            if (self.enabled && !self.read-only) {
                self.text = value;
                self.edited();
            }
        }
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.accent-ink;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
        // input-type does not stop Copy and Cut either: Slint puts the
        // selected text itself on the clipboard, unmasked, where any program
        // can read it and a clipboard manager keeps it. This runs before Slint
        // acts on a key, and swallows the two it copies on, by the test Slint
        // itself applies: control without shift, and "c" or "x". On macOS
        // that is Cmd, which Slint reports as control. Paste is left alone:
        // pasting from a password manager is how many people fill this in.
        key-pressed(event) => {
            if (root.secret && event.modifiers.control && !event.modifiers.shift
                && (event.text == "c" || event.text == "x")) {
                return accept;
            }
            return reject;
        }
    }

    if input.text == "": Text {
        x: root.text-x;
        y: 0;
        width: root.width - root.text-x - Theme.s3;
        height: root.height;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: Theme.t-md;
        vertical-alignment: center;
        overflow: elide;
    }

    // Over a secret field's input, so the pointer never reaches it. When the
    // left button comes up over a TextInput, Slint copies whatever it has
    // selected to the primary selection on Linux, which any program can read
    // and clipboard managers record, again without looking at input-type: a
    // double or triple click, or a drag, put the passphrase there. Here a click
    // only focuses the field. The pointer no longer places the caret, selects
    // or pastes the primary selection with the middle button in a secret
    // field; the keyboard still does all but the last, and selecting with it
    // copies nothing anywhere.
    if root.secret: TouchArea {
        x: input.x;
        y: input.y;
        width: input.width;
        height: input.height;
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                input.focus();
            }
        }
    }
}

export component Check inherits Rectangle {
    in property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback toggled();

    // Checked state is the whole point of a checkbox and the one thing a
    // screen reader cannot infer from the drawing.
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    // Gated here and in the key handler for the reasons Btn gives. The Trust
    // root box on a key generated here is drawn ticked and is always disabled,
    // so a toggle that got through would write a trust root the box cannot
    // show.
    accessible-action-default => {
        if (root.enabled) {
            root.toggled();
        }
    }

    height: 24px;
    // Without this a Check in a row layout expands to an equal share of the
    // width, which spreads two adjacent options to opposite ends of the dialog.
    horizontal-stretch: 0;
    opacity: root.enabled ? 1.0 : 0.45;

    HorizontalLayout {
        spacing: Theme.s2;
        alignment: start;

        Rectangle {
            width: 17px;
            height: 17px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: root.checked ? Theme.accent : Theme.surface-sunken;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.border-strong;
            animate background { duration: Theme.fast; }

            if root.checked: Icon {
                glyph: Icons.check;
                tint: Theme.accent-ink;
                width: 12px;
                height: 12px;
            }
        }

        if root.text != "": Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.t-md;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }

    key := FocusScope {
        width: 0px;
        focus-on-tab-navigation: root.enabled;
        focus-on-click: root.enabled;
        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == " " || event.text == "\n") {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }

    if key.has-focus: ring := Rectangle {
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: 6px;
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
    }
}

// The details pane's Trust root checkbox, and the line under it that says what
// the tick means. Here rather than in app-window.slint so that
// tests/accessibility.rs can reach it: the window is compiled without the
// debug information the testing backend needs to find an element.
export component TrustRootCheck inherits VerticalLayout {
    in property <CertRow> cert;
    in property <bool> busy: false;
    callback toggled();

    // The pane's own spacing, so the two sit where they would as its direct
    // children.
    spacing: Theme.s4;

    Check {
        // Kept short: the checkbox label does not wrap, and the panel is
        // narrow. The line below carries the explanation.
        text: "Trust root";
        // The rule Store::effective_roots applies, not the secret half. A key
        // generated here is a root whatever the explicit list says, so its box
        // is ticked and cannot be cleared from here. A secret key that arrived
        // by import is a root only once it is ticked, as any other certificate
        // is, and can be unticked again.
        checked: root.cert.is-trust-root || root.cert.implicit-root;
        enabled: !root.busy && !root.cert.implicit-root;
        toggled => { root.toggled(); }
    }

    Text {
        text: root.cert.implicit-root
            ? "Keys you generate here are always trust roots."
            : root.cert.has-secret
                ? "An imported key is a trust root only while this is ticked."
                : "Certifications made by this key count as evidence.";
        color: Theme.text-faint;
        font-size: Theme.t-sm;
        wrap: word-wrap;
    }
}

// Whether the details pane offers to revoke the key it shows, and what that
// button says. Functions here rather than a condition in app-window.slint so
// that tests/accessibility.rs can ask them, as it reaches TrustRootCheck: the
// window is compiled without the debug information the testing backend needs
// to find an element.
export global RevokeOffer {
    // Offered for a key held here until a revocation of it is hard. It used to
    // go with the first revocation of any kind, and a key retired with the
    // default, soft, reason could then never be marked compromised: every
    // signature it made before the retirement, and any a thief dates to
    // then, goes on verifying until a hard revocation says otherwise.
    public pure function shown(cert: CertRow) -> bool {
        return cert.has-secret && !cert.revocation-hard;
    }

    // Once a key is retired, only a hard revocation is left to give, and
    // both reasons the dialog then offers, a compromise and no reason given,
    // have the key treated as compromised.
    public pure function label(cert: CertRow) -> string {
        return cert.revocation == "" ? "Revoke this key…" : "Mark as compromised…";
    }
}

// A dropdown. std-widgets' ComboBox would be the platform style's, so this is
// a plain button plus a PopupWindow.
export component Select inherits Rectangle {
    in property <[string]> model;
    /// Each option's key ID, drawn after it in faint monospace and never
    /// elided, where the option itself can be, and read after it as "key ID":
    /// what tells apart two keys that read alike, since a person's old and new
    /// keys commonly carry the same user ID. The signer and certifier lists
    /// fill it; empty where the options are not keys.
    in property <[string]> key-ids;
    in property <bool> enabled: true;
    in-out property <int> current: 0;
    /// Names the choice being made. The chosen option is the value; without a
    /// label a screen reader can say "RFC 9580" but not what it is *for*.
    in property <string> label;
    callback changed(int);

    property <string> chosen: root.current >= 0 && root.current < root.model.length
        ? root.model[root.current]
        : "";
    property <string> chosen-key-id: root.current >= 0 && root.current < root.key-ids.length
        ? root.key-ids[root.current]
        : "";

    accessible-role: combobox;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    // With the key ID, so that someone listening can tell two keys apart as
    // well, in the words a recipient row uses for it.
    accessible-value: root.chosen-key-id == "" ? root.chosen : root.chosen + ", key ID " + root.chosen-key-id;
    // Gated for the reasons Btn gives, here, in the key handler, and on the
    // options, since each is a way of changing the choice.
    accessible-action-default => {
        if (root.enabled) {
            popup.show();
        }
    }

    height: 34px;
    background: Theme.surface-sunken;
    border-radius: Theme.r-sm;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-strong : Theme.border;
    opacity: root.enabled ? 1.0 : 0.5;

    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s2;
        spacing: Theme.s2;

        Text {
            text: root.chosen;
            color: Theme.text;
            font-size: Theme.t-md;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Neither stretches nor elides, so a long option gives way to it.
        if root.chosen-key-id != "": Text {
            text: root.chosen-key-id;
            color: Theme.text-faint;
            font-size: Theme.t-sm;
            font-family: "Source Code Pro";
            vertical-alignment: center;
        }

        Icon {
            glyph: Icons.chevron-down;
            tint: Theme.text-faint;
            y: (parent.height - self.height) / 2;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { popup.show(); }
    }

    key := FocusScope {
        width: 0px;
        focus-on-tab-navigation: root.enabled;
        focus-on-click: root.enabled;
        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == " " || event.text == "\n") {
                popup.show();
                return accept;
            }
            // Up and down move through the options without opening the list,
            // which is what a combobox is expected to do.
            if (event.text == Key.DownArrow && root.current + 1 < root.model.length) {
                root.current += 1;
                root.changed(root.current);
                return accept;
            }
            if (event.text == Key.UpArrow && root.current > 0) {
                root.current -= 1;
                root.changed(root.current);
                return accept;
            }
            return reject;
        }
    }

    if key.has-focus: ring := Rectangle {
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: root.border-radius + 1px;
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(240px, root.model.length * 30px + 2 * Theme.s1);

        Rectangle {
            background: Theme.surface;
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: Theme.s1;

                for label[index] in root.model: Rectangle {
                    height: 30px;
                    border-radius: Theme.r-sm;
                    background: option.has-hover ? Theme.hover
                        : (index == root.current ? Theme.selected : transparent);

                    HorizontalLayout {
                        padding-left: Theme.s2;
                        padding-right: Theme.s2;
                        spacing: Theme.s2;
                        Text {
                            text: label;
                            color: Theme.text;
                            font-size: Theme.t-md;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if root.key-ids[index] != "": Text {
                            text: root.key-ids[index];
                            color: Theme.text-faint;
                            font-size: Theme.t-sm;
                            font-family: "Source Code Pro";
                            vertical-alignment: center;
                        }
                    }

                    // The list can already be open when the Select is
                    // disabled, since nothing closes it when `enabled` changes.
                    option := TouchArea {
                        enabled: root.enabled;
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.current = index;
                            root.changed(index);
                        }
                    }
                }
            }
        }
    }
}

// Coloured initials standing in for a photo. The tint is chosen by the caller
// from a fingerprint hash, so a certificate keeps its colour between sessions.
export component Monogram inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    in property <length> size: 36px;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.tint.transparentize(0.85);
    horizontal-stretch: 0;

    Text {
        text: root.initials;
        color: root.tint;
        font-size: root.size * 0.36;
        font-weight: Theme.w-bold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component SectionLabel inherits Text {
    color: Theme.text-faint;
    font-size: Theme.t-xs;
    font-weight: Theme.w-bold;
    letter-spacing: 0.6px;
}

// Label on the left, value on the right, for the details pane.
export component FieldRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;
    /// Whether this row's value is worth copying. Off by default: an
    /// "Algorithm" or "Created" row does not need one, and a button on every
    /// row would be a column of them down the details pane.
    in property <bool> copyable: false;
    /// Off while a dialog covers the row. The copy button takes keyboard
    /// focus, and behind a dialog's scrim it would be a Tab stop outside the
    /// dialog.
    in property <bool> enabled: true;
    callback copy();

    /// Owned here rather than by the caller, so a row confirms itself and no
    /// usage site has to hold state for it.
    property <bool> copied: false;

    // Every way of copying comes here: a click anywhere on the row, Space or
    // Enter on the copy button, and assistive technology's action on it.
    // Checked here, for the reasons Btn gives, since only the click is kept
    // out by the TouchArea's own `enabled`.
    function copy-now() {
        if (!root.copyable || !root.enabled) {
            return;
        }
        root.copy();
        root.copied = true;
        settle.running = true;
    }

    // A Rectangle tells its parent layout nothing about what is inside it, so
    // the row has to republish the inner layout's own sizing or every dialog
    // built from FieldRows measures short and pushes its buttons off the card.
    min-height: body.min-height;
    preferred-height: body.preferred-height;

    // The whole row is the target, not just the icon: an affordance you have
    // to find by sweeping the pointer around is not one.
    //
    // This is why the value is a Text rather than a read-only TextInput. An
    // input consumes pointer events, so it would both swallow the hover that
    // reveals the button and make a click ambiguous between starting a
    // selection and copying. Selecting part of a value by hand is the price;
    // copying the whole of it in one click is what people actually do with a
    // fingerprint.
    touch := TouchArea {
        enabled: root.copyable && root.enabled;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.copy-now(); }

        settle := Timer {
            interval: 1600ms;
            running: false;
            triggered => {
                root.copied = false;
                self.running = false;
            }
        }

        body := HorizontalLayout {
            spacing: Theme.s3;
            alignment: start;

            Text {
                text: root.label;
                width: 92px;
                color: Theme.text-faint;
                font-size: Theme.t-sm;
                vertical-alignment: top;
            }

            // Two variants rather than a conditional font-family: leaving the
            // family unset is what lets the value inherit the platform's UI
            // font.
            if root.mono: Text {
                text: root.value;
                color: Theme.text;
                font-size: Theme.t-sm;
                font-family: "Source Code Pro";
                horizontal-stretch: 1;
                wrap: word-wrap;
            }

            if !root.mono: Text {
                text: root.value;
                color: Theme.text;
                font-size: Theme.t-md;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }

            if root.copyable: Rectangle {
                // The copy affordance is this element, and it exists only when
                // the row is copyable — which is what lets accessible-role be
                // the constant Slint requires.
                accessible-role: button;
                accessible-label: "Copy " + root.label;
                accessible-description: root.value;
                accessible-enabled: root.enabled;
                accessible-action-default => { root.copy-now(); }
                width: 16px;
                icon := Icon {
                    glyph: root.copied ? Icons.check : Icons.file;
                    tint: root.copied ? Theme.ok : Theme.text-faint;
                    width: 14px;
                    height: 14px;
                    y: 2px;
                    // Kept lit while `copied` so the confirmation is not
                    // dismissed by the pointer moving away after the click,
                    // and while the keyboard is on it, which has no hover.
                    opacity: root.copied || touch.has-hover || key.has-focus ? 1.0 : 0.0;
                    animate opacity { duration: Theme.fast; }
                }

                // Reachable by keyboard, as Btn is. The row had a pointer path
                // and an assistive-technology one, so a keyboard user with no
                // screen reader could not copy a fingerprint at all, which is
                // what the row is for. Inside the button rather than beside
                // it, so that a row with nothing to copy is no Tab stop, and
                // so that assistive technology's own Focus action on the
                // button lands here rather than on the next control along.
                key := FocusScope {
                    width: 0px;
                    focus-on-tab-navigation: root.enabled;
                    focus-on-click: root.enabled;
                    key-pressed(event) => {
                        if (!root.enabled) {
                            return reject;
                        }
                        if (event.text == " " || event.text == "\n") {
                            root.copy-now();
                            return accept;
                        }
                        return reject;
                    }
                }

                // Around the icon, which is what the button is announced as,
                // rather than the whole row.
                if key.has-focus: Rectangle {
                    x: icon.x - 3px;
                    y: icon.y - 3px;
                    width: icon.width + 6px;
                    height: icon.height + 6px;
                    border-width: 2px;
                    border-color: Theme.accent;
                    border-radius: Theme.r-sm;
                }
            }
        }
    }
}

// The note left with a revocation, as a quotation of whoever signed it.
//
// Anyone holding a key can revoke it, a thief as well as its owner, and write
// what they like in the note. The details pane used to run it on after the
// app's own reason, following a dash, in the same red, so that "Replaced by a
// newer key — use 0x… instead" read as the app's advice. Quoted, credited to
// the revocation and in the ordinary colour of text, it reads as someone
// else's words. The note has its hidden characters written out before it gets
// here, so it cannot break the line or turn the words round either.
export component RevocationNote inherits Text {
    in property <string> note;

    text: "Note left with the revocation: “" + root.note + "”";
    color: Theme.text-dim;
    font-size: Theme.t-sm;
    wrap: word-wrap;
}

// The details pane's notice that a certificate is revoked: why, in the app's
// words and its danger colour, and under that any note left with the
// revocation. Here rather than in app-window.slint so that the tests can
// reach it.
//
// It binds no height of its own. Slint sizes a rectangle whose child is a
// layout by what that layout asks for, every wrapped line of the reason and
// the note included, and the pane lays its contents out from the top, so the
// banner is as tall as its text.
export component RevocationBanner inherits Rectangle {
    in property <string> reason;
    in property <string> note;

    background: Theme.danger-soft;
    border-radius: Theme.r-md;

    HorizontalLayout {
        padding: Theme.s3;
        spacing: Theme.s2;

        Icon {
            glyph: Icons.revoke;
            tint: Theme.danger;
            y: 1px;
        }

        VerticalLayout {
            spacing: Theme.s1;
            horizontal-stretch: 1;

            Text {
                text: root.reason;
                color: Theme.danger;
                font-size: Theme.t-sm;
                wrap: word-wrap;
            }

            if root.note != "": RevocationNote {
                note: root.note;
            }
        }
    }
}

// The window's rail tabs, its certificate list and its status line are here
// rather than in app-window.slint so that tests/accessibility.rs can reach
// them, as it reaches TrustRootCheck: the window is compiled without the debug
// information the testing backend needs to find an element.

// One of the rail's scope tabs.
component RailItem inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> text;
    in property <image> glyph;
    in property <int> count;
    in property <bool> active;
    /// Its place among the tabs, from 0.
    in property <int> index;
    callback clicked();

    // A tab, not a button: these switch which set of certificates the list
    // shows, and which one is current is the thing worth announcing. Marked
    // selected, as Slint's own TabWidget marks its current tab, rather than
    // checked: AccessKit turns a checked tab into a toggle, which AT-SPI
    // reports as a checked page tab and UI Automation as a toggle, where a
    // screen reader looks for the selected tab to call current. The index,
    // with the count on ScopeTabs, is what lets it say "2 of 3".
    accessible-role: tab;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-item-index: root.index;
    // Gated for the reasons Btn gives. The window's handler sets `scope`
    // before Rust is asked, and Rust declines while an operation is in
    // flight, so a switch that got through would leave this tab lit over a
    // list it does not describe.
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    height: 34px;
    border-radius: Theme.r-sm;
    background: root.active ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.fast; }

    HorizontalLayout {
        padding-left: Theme.s2;
        padding-right: Theme.s2;
        spacing: Theme.s2;

        Icon {
            glyph: root.glyph;
            tint: root.active ? Theme.accent : Theme.text-dim;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: root.active ? Theme.accent : Theme.text;
            font-size: Theme.t-md;
            font-weight: root.active ? Theme.w-medium : Theme.w-regular;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: "\{root.count}";
            color: Theme.text-faint;
            font-size: Theme.t-sm;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    // Reachable by keyboard, as Btn is. The tabs had only a pointer path and
    // an assistive-technology one, so without a screen reader the list could
    // not be switched from the keyboard at all.
    key := FocusScope {
        width: 0px;
        focus-on-tab-navigation: root.enabled;
        focus-on-click: root.enabled;
        key-pressed(event) => {
            if (!root.enabled) {
                return reject;
            }
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if key.has-focus: ring := Rectangle {
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: root.border-radius + 1px;
        x: -2px;
        y: -2px;
        width: root.width + 4px;
        height: root.height + 4px;
    }
}

// The rail's three scope tabs, which choose the certificates the list shows.
export component ScopeTabs inherits VerticalLayout {
    in property <bool> enabled: true;
    in-out property <int> scope: 0;
    in property <int> count-all: 0;
    in property <int> count-mine: 0;
    in property <int> count-others: 0;
    callback scope-changed(int);

    // The rail's own spacing, so the tabs sit where they did as its direct
    // children.
    spacing: Theme.s2;

    // The three tabs, and only they, make up the tab list: the rail around
    // them also holds the wordmark and the operation buttons, which are no
    // tabs. Without a tab list a screen reader has no set to count them in.
    accessible-role: tab-list;
    accessible-item-count: 3;
    accessible-orientation: vertical;

    RailItem {
        index: 0;
        enabled: root.enabled;
        text: "All certificates";
        glyph: Icons.shield;
        count: root.count-all;
        active: root.scope == 0;
        clicked => { root.scope = 0; root.scope-changed(0); }
    }
    RailItem {
        index: 1;
        enabled: root.enabled;
        text: "My keys";
        glyph: Icons.key;
        count: root.count-mine;
        active: root.scope == 1;
        clicked => { root.scope = 1; root.scope-changed(1); }
    }
    RailItem {
        index: 2;
        enabled: root.enabled;
        text: "Other people";
        glyph: Icons.users;
        count: root.count-others;
        active: root.scope == 2;
        clicked => { root.scope = 2; root.scope-changed(2); }
    }
}

component CertListRow inherits Rectangle {
    in property <CertRow> cert;
    in property <bool> selected;
    in property <bool> enabled: true;
    /// Draw the keyboard's focus ring on this row.
    in property <bool> focused;
    callback clicked();

    // The row announces who it is and whether it is the selected one. The
    // description carries the key ID, which the row's second line shows where
    // there is no address: short enough to hear on every step through the
    // list, where a fingerprint read out at each one would not be. Telling two
    // keys apart for certain is the fingerprint's job, in the details pane.
    accessible-role: list-item;
    accessible-label: root.cert.primary-user-id;
    accessible-description: "Key ID " + root.cert.key-id;
    accessible-enabled: root.enabled;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    // Gated for the reasons Btn gives. As with RailItem, the window's handler
    // sets `current-row` before Rust declines, which would leave the highlight
    // on one certificate and the details pane on another, and some actions
    // take their certificate from the one and some from the other.
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    height: 62px;
    background: root.selected ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.fast; }

    // Accent spine on the selected row.
    Rectangle {
        x: 0;
        width: 3px;
        height: parent.height;
        background: root.selected ? Theme.accent : transparent;
    }

    HorizontalLayout {
        padding-left: Theme.s4;
        padding-right: Theme.s4;
        spacing: Theme.s3;

        Monogram {
            initials: root.cert.initials;
            tint: Theme.monograms[root.cert.tint-index];
            size: 38px;
            y: (parent.height - self.height) / 2;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.cert.name == "" ? root.cert.primary-user-id : root.cert.name;
                color: Theme.text;
                font-size: Theme.t-lg;
                font-weight: Theme.w-medium;
                overflow: elide;
            }

            Text {
                text: root.cert.email == "" ? root.cert.key-id : root.cert.email;
                color: Theme.text-dim;
                font-size: Theme.t-sm;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 0;

            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                // Only shown once there is something to say. An "unverified"
                // badge on every stranger in the list would be noise, and the
                // details pane spells it out anyway.
                if root.cert.authentication != "unverified": Pill {
                    text: root.cert.authentication;
                    tone: root.cert.authentication == "verified" ? Tone.ok : Tone.warn;
                    glyph: Icons.certify;
                }

                if root.cert.card-serial != "": Pill {
                    text: "smartcard";
                    tone: Tone.accent;
                    glyph: Icons.key;
                }

                if root.cert.has-secret && root.cert.card-serial == "": Pill {
                    text: "secret key";
                    tone: Tone.accent;
                    glyph: Icons.key;
                }

                Pill {
                    text: root.cert.validity;
                    tone: root.cert.validity == "valid" ? Tone.ok
                        : root.cert.validity == "expired" ? Tone.warn
                        : Tone.danger;
                }
            }

            Text {
                text: root.cert.expires == ""
                    ? root.cert.capabilities + " · never expires"
                    : root.cert.capabilities + " · until " + root.cert.expires;
                color: Theme.text-faint;
                font-size: Theme.t-xs;
                horizontal-alignment: right;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    // Inside the row rather than around it, since the list clips what is
    // drawn past its edges.
    if root.focused: ring := Rectangle {
        x: 2px;
        y: 2px;
        width: root.width - 4px;
        height: root.height - 4px;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: Theme.r-sm;
    }
}

// CertList's rows. A component of their own because Slint lets a ListView
// hold one `for` and nothing else, and CertList has to put its FocusScope
// inside the list too; a component derived from ListView may add to it, which
// is how Slint's own StandardListView does the same.
component CertRows inherits ListView {
    in property <[CertRow]> certs;
    /// The rows' `enabled`. Not the list's own, which ScrollView already has
    /// for its scrollbars, and which stays on: a list behind a dialog or an
    /// operation can still be scrolled to read it.
    in property <bool> rows-enabled: true;
    in property <int> current-row: -1;
    /// Draw the focus ring on the current row.
    in property <bool> ring: false;
    callback clicked(int);

    for cert[index] in root.certs: CertListRow {
        cert: cert;
        enabled: root.rows-enabled;
        selected: index == root.current-row;
        focused: root.ring && index == root.current-row;
        clicked => { root.clicked(index); }
    }
}

// The certificate list, which the keyboard works as well as the pointer.
//
// Its rows had only a pointer path and an assistive-technology one, and
// std-widgets' ListView adds no keys, so without a screen reader nothing could
// be selected from the keyboard, and everything that acts on a selection was
// out of reach. Now Tab stops at the list, and Up and Down move the selection
// a row, Page Up and Page Down a screenful, and Home and End to either end,
// each as a click on that row would, scrolling it into view.
//
// One FocusScope for the whole list, as Slint's own StandardListView has it,
// rather than one for each row: every scope is a Tab stop, and a keyring can
// hold thousands of certificates. It sits inside the list, as that one's
// does, so that the list is what assistive technology is told has focus. The
// list builds rows only for what is on screen, so the keys ask nothing of
// them; every row is the same height, and where one is follows from its
// index.
export component CertList inherits Rectangle {
    in property <[CertRow]> certs;
    in property <bool> enabled: true;
    in-out property <int> current-row: -1;
    callback row-selected(int);

    property <length> row-height: 62px;
    // Whole rows in view, which Page Up and Page Down move by.
    property <int> page: max(1, floor(list.visible-height / root.row-height));
    // Whether focus came from the keyboard, which is when the ring is drawn.
    // A click focuses the list as well, so that the arrow keys go on from
    // the row clicked, and a ring on every clicked row would only repeat
    // what its highlight already says.
    property <bool> keyboard: false;

    // Select the row at `index`, clamped to the list, as a click on it would,
    // and scroll it into view. A key that moves nowhere selects nothing, so
    // one held at either end does not go on asking Rust for the same row.
    function move-to(index: int) {
        let row = max(0, min(root.certs.length - 1, index));
        root.reveal(row);
        if (row != root.current-row) {
            root.current-row = row;
            root.row-selected(row);
        }
    }

    // Scroll the list as little as brings `row` wholly into view.
    //
    // Except that a jump down of more than a screen goes to a whole row.
    // ListView lays out a long jump afresh from the row at the top edge,
    // rounding where the list is scrolled to down to a whole row, so End,
    // scrolled to just show the last row, came to rest with that row cut off
    // by the bottom edge. A whole row comes through the rounding as it is,
    // and one past the end of the list ListView brings back to the end,
    // which shows the last row whole. A jump up already goes to a whole row.
    function reveal(row: int) {
        let top = row * root.row-height;
        let wanted = top < -list.viewport-y ? -top
            : top + root.row-height > list.visible-height - list.viewport-y
                ? list.visible-height - top - root.row-height
                : list.viewport-y;
        if (wanted < list.viewport-y - list.visible-height) {
            list.viewport-y = -ceil((top + root.row-height - list.visible-height) / root.row-height)
                * root.row-height;
        } else {
            list.viewport-y = wanted;
        }
    }

    list := CertRows {
        certs: root.certs;
        rows-enabled: root.enabled;
        current-row: root.current-row;
        ring: key.has-focus && root.keyboard;
        accessible-label: "Certificates";
        clicked(index) => {
            root.keyboard = false;
            key.focus();
            root.current-row = index;
            root.row-selected(index);
        }

        key := FocusScope {
            x: 0;
            y: 0;
            width: 0px;
            height: 0px;
            // Not `enabled`, for the reason Btn gives.
            focus-on-tab-navigation: root.enabled;
            focus-on-click: root.enabled;
            focus-gained(reason) => {
                if (reason == FocusReason.tab-navigation) {
                    root.keyboard = true;
                }
            }
            key-pressed(event) => {
                // Rejected while disabled, for the reasons Btn gives. The
                // window's handler for a row declines while an operation is
                // in flight, and a highlight moved here would then sit on a
                // row the details pane is not showing.
                if (!root.enabled || root.certs.length == 0) {
                    return reject;
                }
                // With nothing selected, Up and Down both start at the top.
                if (event.text == Key.DownArrow) {
                    root.move-to(root.current-row + 1);
                } else if (event.text == Key.UpArrow) {
                    root.move-to(max(0, root.current-row - 1));
                } else if (event.text == Key.PageDown) {
                    root.move-to(root.current-row + root.page);
                } else if (event.text == Key.PageUp) {
                    root.move-to(root.current-row - root.page);
                } else if (event.text == Key.Home) {
                    root.move-to(0);
                } else if (event.text == Key.End) {
                    root.move-to(root.certs.length - 1);
                } else {
                    return reject;
                }
                root.keyboard = true;
                return accept;
            }
        }
    }

    // With nothing selected there is no row to draw the ring on, so it goes
    // around the list.
    if key.has-focus && root.keyboard && root.current-row < 0: ring := Rectangle {
        x: 1px;
        y: 1px;
        width: root.width - 2px;
        height: root.height - 2px;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: Theme.r-sm;
    }
}

// The line along the foot of the window: what is under way, and how the last
// operation went.
//
// It wraps rather than elides. Some of what it says ends with what to do, and
// one line cut that off with no way to read the rest: a publish whose
// confirmation mail could not be asked for ends "Publish again to retry",
// about 1750px of text at 12px, against the 1148px the line had at the
// window's usual width. The bar grows to hold a message up to `tallest`, and
// shows the beginning of a longer one, eliding the rest; assistive technology
// is given the whole of it whatever is shown.
export component StatusBar inherits Rectangle {
    in property <string> text;
    in property <bool> busy: false;
    /// Whether a change is announced to assistive technology. The window turns
    /// this off while a dialog is open: the dialog is where the user is, and it
    /// says for itself how its own operation went, so the same words would
    /// otherwise be read twice.
    in property <bool> announce: true;

    // The bar's height with one line in it, which is all most messages take.
    property <length> line-height: 28px;
    // Above the first line and below the last.
    property <length> inset: 5px;
    // The most a long message may take: five lines of its 12px text. The
    // smallest window the app allows leaves the bar 91px below the rail, and
    // what goes past the window's edge is not drawn, so a taller bar would
    // lose its last line there, and with it the ellipsis that says the message
    // goes on. The publish above takes three lines at that width. Revoking
    // several keys at once, or refusing a user ID and quoting it back, can
    // take more, and those messages say what matters first. A length rather
    // than a share of the window, because the bar's height is part of what
    // sizes the window, and a share would be a binding loop.
    property <length> tallest: 88px;
    height: max(root.line-height, min(root.tallest, message.preferred-height + 2 * root.inset));
    background: Theme.surface-sunken;

    Rectangle {
        y: 0;
        height: 1px;
        width: parent.width;
        background: Theme.border;
    }

    if root.busy: Rectangle {
        x: Theme.s4;
        // Level with the first line, however many there are.
        y: (root.line-height - self.height) / 2;
        width: 7px;
        height: 7px;
        border-radius: 4px;
        background: Theme.accent;
        opacity: 0.4;
        animate opacity { duration: 700ms; iteration-count: -1; direction: alternate; }
    }

    // Positioned rather than laid out, and its width bound, for the reason the
    // result banners in dialogs.slint give: only a wrapping text whose width
    // is already settled reports the height of the lines it wraps to.
    message := Text {
        x: root.busy ? Theme.s4 + 7px + Theme.s2 : Theme.s4;
        y: root.inset;
        width: root.width - self.x - Theme.s4;
        height: root.height - 2 * root.inset;
        text: root.text;
        color: Theme.text-dim;
        font-size: Theme.t-sm;
        // Centred while the bar holds the message, which puts a single line
        // in the middle of the bar. A longer one starts at the top. Slint
        // drops the lines that do not fit from the edges the alignment pushes
        // them past, so centred it would drop as many off the top as off the
        // bottom, and the top is where a message says what happened.
        vertical-alignment: self.preferred-height > self.height ? top : center;
        wrap: word-wrap;
        overflow: elide;
        accessible-live-region: root.announce ? AccessibleLiveness.polite : AccessibleLiveness.off;
    }
}

// Why an operation a dialog started has failed, for the dialog to show above
// its buttons.
//
// A dialog stays open when its operation fails, so that what was wrong can be
// put right and the button pressed again, and the reason used to go to the
// status line alone. That lies under the dialog's scrim, which takes its
// small grey text down to 2.4:1 in the light theme and 1.5:1 in the dark,
// and nothing announced it: the button went from "Certifying…" back to
// "Certify" with no reason anyone could read. Assertive, because the user
// has just pressed the button that failed and is waiting on its answer.
export component DialogError inherits Text {
    color: Theme.danger;
    font-size: Theme.t-sm;
    wrap: word-wrap;
    accessible-live-region: assertive;
}

export component DialogShell inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <length> card-width: 460px;
    /// An operation this dialog started is in flight. Every dialog's Cancel or
    /// Close is disabled then, since nothing can call the operation back, and
    /// Escape and a click on the scrim leave the dialog open as well. They used
    /// to close it, which looked like cancelling a delete, a revocation or a
    /// publish that went on to happen regardless.
    in property <bool> busy: false;
    /// Why the operation this dialog started failed, or nothing. Declared here
    /// so that every dialog that runs something takes it the same way; each
    /// draws it above its buttons as a DialogError.
    in property <string> error: "";
    callback dismissed();

    background: Theme.scrim;

    // Swallow clicks so the list behind stays inert, and close on Escape,
    // unless an operation is in flight.
    TouchArea {
        clicked => {
            if (!root.busy) {
                root.dismissed();
            }
        }
    }

    // The scope wraps the card rather than sitting beside it. Slint delivers a
    // key only along the focused item's ancestor chain, so as a sibling this
    // never saw Escape once a Field inside the card took focus — which is the
    // state a user is in immediately after typing a name or a passphrase, in
    // nine of the twelve dialogs. An explicit size is required: FocusScope
    // reports no layout info of its own, and a zero-sized scope would leave
    // the card centred against nothing and drawn off-screen.
    focus := FocusScope {
        width: 100%;
        height: 100%;
        // Focus is put here when the dialog opens, and Tab passes over it
        // unless an operation is in flight: it draws nothing, and as a stop
        // it was an invisible one on every round of the dialog's controls.
        // Tab stays among those controls because the window disables
        // everything behind the scrim while a dialog is open, and opens no
        // dialog over another; see `dialog-open` in app-window.slint.
        //
        // While an operation runs, the dialog's own controls are disabled
        // as well, and Tab needs somewhere to land. When nothing takes it,
        // Slint leaves keys going to the control Tab left, which is the
        // button that started the operation: it has been told that focus
        // left it, so it draws no ring, but it still receives every key.
        // Once a failure enabled it again, one Enter ran the operation a
        // second time with nothing on screen to show where the key had gone.
        // Here Tab lands on the frame, which answers nothing but Escape.
        focus-on-tab-navigation: root.busy;
        key-pressed(event) => {
            // Taken either way, so that Escape goes no further while the
            // dialog stays.
            if (event.text == Key.Escape) {
                if (!root.busy) {
                    root.dismissed();
                }
                return accept;
            }
            return reject;
        }

        card := Rectangle {
            width: root.card-width;
            // min() rather than max-height: setting both height and max-height is
            // a Slint warning, and the card must never outgrow the window.
            // s4, not s6: a 32px gutter top and bottom cost 64px of the window,
            // which on a short screen is the difference between a dialog fitting
            // and needing to be scrolled by one line.
            height: min(content.preferred-height, root.height - 2 * Theme.s4);
            // Belt and braces for the case a dialog's content still cannot fit:
            // clipped is recoverable, whereas controls drawn outside the card look
            // like a rendering fault.
            clip: true;
            background: Theme.surface;
            border-radius: Theme.r-lg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 48px;
            drop-shadow-color: #00000059;
            drop-shadow-offset-y: 16px;

            // Clicks inside the card must not reach the scrim behind it.
            TouchArea {}

            content := VerticalLayout {
                padding: Theme.s5;
                spacing: Theme.s4;

                VerticalLayout {
                    spacing: Theme.s1;
                    // Conditional like the subtitle below, so a dialog that draws
                    // its own heading — About, with the wordmark — does not get an
                    // empty line above it.
                    if root.title != "": Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: Theme.t-xl;
                        font-weight: Theme.w-bold;
                    }
                    if root.subtitle != "": Text {
                        text: root.subtitle;
                        color: Theme.text-dim;
                        font-size: Theme.t-md;
                        wrap: word-wrap;
                    }
                }

                @children
            }
        }

        init => { focus.focus(); }
    }
}

/// Multi-line text entry, for the notepad.
///
/// The input is sized from *this* element rather than from the ScrollView it
/// sits in. Taking the width from the viewport closes a binding loop — the
/// viewport sizes from its content and the content from the viewport — and
/// letting the input drive its own height makes the box grow as you type,
/// because a TextInput reports its content height as a minimum and a layout
/// honours a minimum over an explicit height.
export component TextArea inherits Rectangle {
    in property <string> placeholder;
    in property <bool> enabled: true;
    /// For text shown to be read and copied rather than edited. Not the same
    /// as disabled: a disabled area cannot have its text selected either.
    in property <bool> read-only: false;
    in-out property <string> text <=> input.text;
    callback edited(string);

    background: Theme.surface-sunken;
    border-radius: Theme.r-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    clip: true;
    // Stops the inner text from pushing the box outwards as it grows.
    min-height: 0px;
    max-height: root.height;

    scroll := ScrollView {
        x: Theme.s3;
        y: Theme.s3;
        width: root.width - 2 * Theme.s3;
        height: root.height - 2 * Theme.s3;
        viewport-width: self.visible-width;
        // Without a viewport taller than the visible area the ScrollView has
        // nothing to scroll and shows no scrollbar.
        viewport-height: max(self.visible-height, input.preferred-height);

        input := TextInput {
            width: scroll.visible-width;
            color: Theme.text;
            font-size: Theme.t-md;
            font-family: "Source Code Pro";
            single-line: false;
            wrap: word-wrap;
            // Disabled and guarded for the reasons Field gives. The notepad's
            // editor is disabled while a run is in flight, and its output
            // is read-only rather than disabled so that it stays selectable.
            read-only: root.read-only || !root.enabled;
            enabled: root.enabled;
            accessible-action-set-value(value) => {
                if (self.enabled && !self.read-only) {
                    self.text = value;
                    self.edited();
                }
            }
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.accent-ink;
            edited => { root.edited(self.text); }
        }
    }

    if input.text == "": Text {
        x: Theme.s3;
        y: Theme.s3;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: Theme.t-md;
    }
}
