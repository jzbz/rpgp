import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon } from "theme.slint";
import { Btn, Check, DialogShell, Divider, Field, FieldRow, Monogram, Pill, SectionLabel, Select, TextArea, Tone, Variant } from "widgets.slint";
import { CertRow, CertificationRow, LookupRow, RecipientRow, SignatureRow, SubkeyRow, UserIdDetailRow, UserIdRow } from "types.slint";

// A file slot: label, the chosen path (or a hint), and a Choose button.
component FilePick inherits VerticalLayout {
    in property <string> label;
    in property <string> path;
    in property <string> hint: "No file chosen";
    in property <bool> enabled: true;
    callback pick();

    spacing: 6px;

    Text {
        text: root.label;
        color: Theme.text-dim;
        font-size: Theme.t-sm;
    }

    Rectangle {
        height: 40px;
        background: Theme.surface-sunken;
        border-radius: Theme.r-sm;
        border-width: 1px;
        border-color: Theme.border;

        HorizontalLayout {
            padding-left: Theme.s3;
            padding-right: Theme.s1;
            spacing: Theme.s2;

            Icon {
                glyph: Icons.file;
                tint: root.path == "" ? Theme.text-faint : Theme.accent;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.path == "" ? root.hint : root.path;
                color: root.path == "" ? Theme.text-faint : Theme.text;
                font-size: Theme.t-md;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            Btn {
                text: "Choose…";
                variant: Variant.ghost;
                enabled: root.enabled;
                y: (parent.height - self.height) / 2;
                clicked => { root.pick(); }
            }
        }
    }
}

export component KeygenDialog inherits DialogShell {
    in property <bool> busy;
    callback accepted(string, string, string, int, int, int);

    title: "New key pair";
    subtitle: "The passphrase protects the secret key on disk. It cannot be recovered.";
    card-width: 470px;

    VerticalLayout {
        spacing: Theme.s3;

        name-input := Field { placeholder: "Name"; enabled: !root.busy; }
        email-input := Field { placeholder: "name@example.org"; enabled: !root.busy; }
        pass-input := Field { placeholder: "Passphrase (optional)"; secret: true; enabled: !root.busy; }

        HorizontalLayout {
            spacing: Theme.s3;

            VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Key type";
                    color: Theme.text-dim;
                    font-size: Theme.t-sm;
                }
                key-type := Select {
                    label: "Key type";
                    model: ["Curve 25519 (recommended)", "RSA 3072", "RSA 4096"];
                    enabled: !root.busy;
                }
            }

            VerticalLayout {
                spacing: 6px;
                width: 130px;
                Text {
                    text: "Expires";
                    color: Theme.text-dim;
                    font-size: Theme.t-sm;
                }
                expiry := Select {
                    label: "Expires";
                    model: ["in 2 years", "in 1 year", "in 5 years", "never"];
                    enabled: !root.busy;
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            Text {
                text: "Standard";
                color: Theme.text-dim;
                font-size: Theme.t-sm;
            }
            standard := Select {
                label: "Standard";
                model: ["Modern (RFC 9580)", "Compatible (RFC 4880)"];
                enabled: !root.busy;
            }
            Text {
                text: standard.current == 0
                    ? "Stronger encryption. GnuPG 2.5 and later, and Sequoia. Older "
                      + "software cannot encrypt to this key or check its signatures."
                    : "Works with GnuPG 2.4 and everything older, using its weaker "
                      + "encryption.";
                color: Theme.text-faint;
                font-size: Theme.t-sm;
                wrap: word-wrap;
            }
        }

        Divider { }

        HorizontalLayout {
            spacing: Theme.s2;
            alignment: end;

            Btn {
                text: "Cancel";
                variant: Variant.ghost;
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
            Btn {
                text: root.busy ? "Generating…" : "Create key pair";
                variant: Variant.primary;
                enabled: !root.busy && name-input.text != "" && email-input.text != "";
                clicked => {
                    root.accepted(
                        name-input.text,
                        email-input.text,
                        pass-input.text,
                        key-type.current,
                        expiry.current,
                        standard.current,
                    );
                }
            }
        }
    }
}

export component SignEncryptDialog inherits DialogShell {
    in property <string> input-path;
    in property <string> output-encrypt;
    in property <string> output-sign;
    in property <[RecipientRow]> recipients;
    in property <[string]> signers;
    in property <bool> busy;
    callback pick-input();
    callback toggle-recipient(int);
    callback run(bool, bool, int, string, string);

    // Held on the dialog rather than read off the widgets: both the passphrase
    // field and the signer dropdown live inside `if` blocks, and a conditional
    // element cannot be referenced from the footer.
    property <string> password;
    /// Symmetric passphrase, entirely separate from the signing key's.
    property <string> secret;
    property <int> signer-index: 0;

    // Counted in Rust: Slint has no way to fold over a model in an expression.
    in property <int> chosen-recipients: 0;

    property <bool> want-encrypt: true;
    property <bool> want-sign: true;
    property <bool> can-run:
        root.input-path != ""
        && (root.want-encrypt || root.want-sign)
        && (!root.want-encrypt || root.chosen-recipients > 0 || root.secret != "")
        && (!root.want-sign || root.signers.length > 0);

    title: "Sign / Encrypt file";
    card-width: 540px;

    VerticalLayout {
        spacing: Theme.s4;

        // The form scrolls; the footer below does not. Every row here is a
        // fixed height — the file slot, the 168px recipients box, the fields,
        // the signer select — so the content is 671px tall against a card that
        // the window's own minimum (860x520) clamps to 488px. Slint does not
        // shrink explicitly-sized children, so Cancel and Run fell off the
        // bottom: not merely clipped but absent from the item tree, with no
        // keyboard path to either.
        //
        // min-height 0 lets the card take height away from the form instead of
        // from the footer; preferred-height keeps the dialog its natural size
        // whenever the window is tall enough, which is the usual case.
        ScrollView {
            min-height: 0px;
            preferred-height: form.preferred-height;
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            viewport-height: max(self.visible-height, form.preferred-height);

            form := VerticalLayout {
                spacing: Theme.s4;

            FilePick {
                label: "File";
                path: root.input-path;
                enabled: !root.busy;
                pick => { root.pick-input(); }
            }

            HorizontalLayout {
                spacing: Theme.s5;
                alignment: start;
                // Unticking clears what the section collected. The fields below
                // are conditional and are destroyed with the section, but the
                // properties they wrote into are not — so a password typed, hidden
                // and forgotten would otherwise still enable Run and still be
                // used, from a field the user can no longer see.
                Check {
                    text: "Encrypt";
                    checked: root.want-encrypt;
                    enabled: !root.busy;
                    toggled => {
                        root.want-encrypt = !root.want-encrypt;
                        if !root.want-encrypt { root.secret = ""; }
                    }
                }
                Check {
                    text: "Sign";
                    checked: root.want-sign;
                    enabled: !root.busy && root.signers.length > 0;
                    toggled => {
                        root.want-sign = !root.want-sign;
                        if !root.want-sign { root.password = ""; }
                    }
                }
            }

            if root.want-encrypt: VerticalLayout {
                spacing: 6px;

                HorizontalLayout {
                    Text {
                        text: "Recipients";
                        color: Theme.text-dim;
                        font-size: Theme.t-sm;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.chosen-recipients == 0
                            ? "none selected"
                            : "\{root.chosen-recipients} selected";
                        color: root.chosen-recipients == 0 ? Theme.warn : Theme.text-dim;
                        font-size: Theme.t-sm;
                    }
                }

                Rectangle {
                    height: 168px;
                    background: Theme.surface-sunken;
                    border-radius: Theme.r-sm;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    if root.recipients.length == 0: Text {
                        text: "No certificate in the store can receive encrypted mail.";
                        color: Theme.text-faint;
                        font-size: Theme.t-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        width: parent.width - 2 * Theme.s4;
                    }

                    if root.recipients.length > 0: ListView {
                        for entry[index] in root.recipients: Rectangle {
                            height: 42px;
                            background: pick.has-hover ? Theme.hover : transparent;

                            // The row draws a tick box but is not one: without these a screen
                            // reader sees an unlabelled rectangle and cannot tell a chosen
                            // recipient from an unchosen one. Check declares the same set.
                            accessible-role: checkbox;
                            accessible-label: entry.label + ", " + entry.sublabel;
                            accessible-checkable: true;
                            accessible-checked: entry.selected;
                            accessible-action-default => { root.toggle-recipient(index); }

                            HorizontalLayout {
                                padding-left: Theme.s3;
                                padding-right: Theme.s3;
                                spacing: Theme.s3;

                                Rectangle {
                                    width: 17px;
                                    height: 17px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 5px;
                                    background: entry.selected ? Theme.accent : Theme.surface;
                                    border-width: 1px;
                                    border-color: entry.selected ? Theme.accent : Theme.border-strong;
                                    if entry.selected: Icon {
                                        glyph: Icons.check;
                                        tint: Theme.accent-ink;
                                        width: 12px;
                                        height: 12px;
                                    }
                                }

                                Monogram {
                                    initials: entry.initials;
                                    tint: Theme.monograms[entry.tint-index];
                                    size: 26px;
                                    y: (parent.height - self.height) / 2;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: entry.label;
                                        color: Theme.text;
                                        font-size: Theme.t-md;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: entry.sublabel;
                                        color: Theme.text-faint;
                                        font-size: Theme.t-xs;
                                        overflow: elide;
                                    }
                                }
                            }

                            pick := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.toggle-recipient(index); }
                            }
                        }
                    }
                }
            }

            if root.want-encrypt: Field {
                placeholder: "Or a password — anyone with it can open the file";
                secret: true;
                enabled: !root.busy;
                edited(text) => { root.secret = text; }
            }

            if root.want-sign && root.signers.length > 0: VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Sign as";
                    color: Theme.text-dim;
                    font-size: Theme.t-sm;
                }
                Select {
                    label: "Sign as";
                    model: root.signers;
                    enabled: !root.busy;
                    current: root.signer-index;
                    changed(index) => { root.signer-index = index; }
                }
            }

            if root.want-sign: Field {
                placeholder: "Passphrase for the signing key (if any)";
                secret: true;
                enabled: !root.busy;
                edited(text) => { root.password = text; }
            }

            if root.input-path != "": Text {
                text: "Writes " + (root.want-encrypt ? root.output-encrypt : root.output-sign);
                color: Theme.text-faint;
                font-size: Theme.t-sm;
                overflow: elide;
            }
            }
        }

        Divider { }

        HorizontalLayout {
            spacing: Theme.s2;
            alignment: end;
            Btn {
                text: "Cancel";
                variant: Variant.ghost;
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
            Btn {
                text: root.busy ? "Working…" : "Run";
                variant: Variant.primary;
                enabled: !root.busy && root.can-run;
                clicked => {
                    root.run(
                        root.want-encrypt,
                        root.want-sign,
                        root.signer-index,
                        root.password,
                        root.secret,
                    );
                }
            }
        }
    }
}

export component DecryptVerifyDialog inherits DialogShell {
    in property <string> input-path;
    in property <string> data-path;
    in property <bool> needs-data;
    in property <string> output-path;
    in property <[SignatureRow]> signatures;
    in property <string> result;
    // 0 nothing yet, 1 good, 2 mixed, 3 bad
    in property <int> result-tone;
    in property <bool> busy;
    callback pick-input();
    callback pick-data();
    callback run(string);

    property <string> password;
    // A passphrase belongs to the file it was typed for. Choosing another
    // input destroys and recreates the passphrase field, empty — but not the
    // property behind it, so a passphrase from the last file would be sent
    // with the next one from a field showing nothing.
    changed input-path => { root.password = ""; }
    property <bool> can-run:
        root.input-path != "" && (!root.needs-data || root.data-path != "");

    title: "Decrypt / Verify";
    card-width: 540px;

    VerticalLayout {
        spacing: Theme.s4;

        FilePick {
            label: "Message or signature";
            path: root.input-path;
            enabled: !root.busy;
            pick => { root.pick-input(); }
        }

        if root.needs-data: FilePick {
            label: "Signed file";
            hint: "This is a detached signature — choose the file it signs";
            path: root.data-path;
            enabled: !root.busy;
            pick => { root.pick-data(); }
        }

        if !root.needs-data && root.input-path != "": Field {
            placeholder: "Passphrase for the secret key (if any)";
            secret: true;
            enabled: !root.busy;
            edited(text) => { root.password = text; }
        }

        if root.output-path != "" && !root.needs-data: Text {
            text: "Writes " + root.output-path;
            color: Theme.text-faint;
            font-size: Theme.t-sm;
            overflow: elide;
        }

        if root.result != "": Rectangle {
            background: root.result-tone == 1 ? Theme.ok-soft
                : root.result-tone == 2 ? Theme.warn-soft
                : Theme.danger-soft;
            border-radius: Theme.r-md;

            VerticalLayout {
                padding: Theme.s3;
                spacing: Theme.s2;

                HorizontalLayout {
                    spacing: Theme.s2;
                    Icon {
                        glyph: root.result-tone == 1 ? Icons.check : Icons.cross;
                        tint: root.result-tone == 1 ? Theme.ok
                            : root.result-tone == 2 ? Theme.warn
                            : Theme.danger;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.result;
                        color: root.result-tone == 1 ? Theme.ok
                            : root.result-tone == 2 ? Theme.warn
                            : Theme.danger;
                        font-size: Theme.t-md;
                        font-weight: Theme.w-medium;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }

                for signature in root.signatures: HorizontalLayout {
                    spacing: Theme.s2;
                    padding-left: 24px;
                    Pill {
                        text: signature.good ? "good" : "bad";
                        tone: signature.good ? Tone.ok : Tone.danger;
                        y: (parent.height - self.height) / 2;
                    }
                    // Two different questions, two pills: the first says the
                    // signature checks out against a key, this one says
                    // whether that key is known to belong to the name beside
                    // it. Only the second is reassuring on its own.
                    if signature.good: Pill {
                        text: signature.authentication;
                        tone: signature.authenticated ? Tone.accent : Tone.warn;
                        y: (parent.height - self.height) / 2;
                    }
                    // A third question again: not whether the signature checks
                    // out, nor whether the name is vouched for, but how much a
                    // check that passed is worth. SHA-1 collisions are
                    // practical, so this one says the key was involved rather
                    // than that its holder signed this.
                    if signature.sha1: Pill {
                        text: "SHA-1";
                        tone: Tone.warn;
                        y: (parent.height - self.height) / 2;
                    }
                    // The nesting is load-bearing, not tidiness. As a direct
                    // stretchy child of this row the text was allotted one
                    // line's height, wrapped to two, and had the overflow
                    // clipped by the banner — worse the longer the failure,
                    // which is backwards for the message that most needs
                    // reading. Its width is only settled after the pills
                    // beside it are measured, and by then the row's height
                    // has been decided; a layout of its own is what lets the
                    // wrapped height propagate back out. `alignment: center`
                    // keeps a one-line signer level with the pills, which is
                    // what `vertical-alignment` on the text used to do — and
                    // that centred a two-line text inside a one-line box, so
                    // it spilled past both edges rather than just the bottom.
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: signature.good
                                ? signature.signer
                                : (signature.detail == "" ? signature.signer : signature.detail);
                            color: Theme.text;
                            font-size: Theme.t-sm;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        Divider { }

        HorizontalLayout {
            spacing: Theme.s2;
            alignment: end;
            Btn {
                text: root.result == "" ? "Cancel" : "Close";
                variant: Variant.ghost;
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
            Btn {
                text: root.busy ? "Working…" : (root.needs-data ? "Verify" : "Decrypt");
                variant: Variant.primary;
                enabled: !root.busy && root.can-run;
                clicked => { root.run(root.password); }
            }
        }
    }
}

export component CertifyDialog inherits DialogShell {
    in property <string> target-name;
    in property <[UserIdRow]> user-ids;
    in property <[string]> certifiers;
    in property <int> chosen-count;
    in property <bool> busy;
    callback toggle-user-id(int);
    callback run(int, bool, bool, int, string);

    property <string> password;
    property <int> certifier-index: 0;
    property <int> confidence: 0;
    property <bool> publishable: true;
    property <bool> introducer: false;
    property <bool> can-run: root.chosen-count > 0 && root.certifiers.length > 0;

    title: "Certify identity";
    subtitle: "Confirm that these user IDs really belong to " + root.target-name
        + ". Only certify what you have actually checked — in person, or over a "
        + "channel you already trust.";
    card-width: 540px;

    VerticalLayout {
        spacing: Theme.s4;

        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                Text {
                    text: "User IDs";
                    color: Theme.text-dim;
                    font-size: Theme.t-sm;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.chosen-count == 0 ? "none selected" : "\{root.chosen-count} selected";
                    color: root.chosen-count == 0 ? Theme.warn : Theme.text-dim;
                    font-size: Theme.t-sm;
                }
            }

            Rectangle {
                height: min(140px, max(46px, root.user-ids.length * 34px + 8px));
                background: Theme.surface-sunken;
                border-radius: Theme.r-sm;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                ListView {
                    for entry[index] in root.user-ids: Rectangle {
                        height: 34px;
                        background: pick.has-hover ? Theme.hover : transparent;

                        // The row draws a tick box but is not one: without these a screen
                        // reader sees an unlabelled rectangle and cannot tell a chosen
                        // recipient from an unchosen one. Check declares the same set.
                        accessible-role: checkbox;
                        accessible-label: entry.text;
                        accessible-checkable: true;
                        accessible-checked: entry.selected;
                        accessible-action-default => { root.toggle-user-id(index); }

                        HorizontalLayout {
                            padding-left: Theme.s3;
                            padding-right: Theme.s3;
                            spacing: Theme.s3;

                            Rectangle {
                                width: 17px;
                                height: 17px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: entry.selected ? Theme.accent : Theme.surface;
                                border-width: 1px;
                                border-color: entry.selected ? Theme.accent : Theme.border-strong;
                                if entry.selected: Icon {
                                    glyph: Icons.check;
                                    tint: Theme.accent-ink;
                                    width: 12px;
                                    height: 12px;
                                }
                            }

                            Text {
                                text: entry.text;
                                color: Theme.text;
                                font-size: Theme.t-md;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }

                        pick := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.toggle-user-id(index); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.s3;

            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    text: "Certify with";
                    color: Theme.text-dim;
                    font-size: Theme.t-sm;
                }
                Select {
                    label: "Certify with";
                    model: root.certifiers;
                    enabled: !root.busy;
                    current: root.certifier-index;
                    changed(index) => { root.certifier-index = index; }
                }
            }

            VerticalLayout {
                spacing: 6px;
                width: 150px;
                Text {
                    text: "Confidence";
                    color: Theme.text-dim;
                    font-size: Theme.t-sm;
                }
                Select {
                    label: "Confidence";
                    model: ["Full", "Partial"];
                    enabled: !root.busy;
                    current: root.confidence;
                    changed(index) => { root.confidence = index; }
                }
            }
        }

        VerticalLayout {
            spacing: Theme.s2;

            Check {
                text: "Publishable — others may see this certification";
                checked: root.publishable;
                enabled: !root.busy;
                toggled => { root.publishable = !root.publishable; }
            }
            Check {
                text: "Treat as a trusted introducer";
                checked: root.introducer;
                enabled: !root.busy;
                toggled => { root.introducer = !root.introducer; }
            }
            if root.introducer: Text {
                text: "Certificates this key certifies will also count as verified here.";
                color: Theme.text-faint;
                font-size: Theme.t-sm;
                wrap: word-wrap;
            }
        }

        Field {
            placeholder: "Passphrase for your certifying key (if any)";
            secret: true;
            enabled: !root.busy;
            edited(text) => { root.password = text; }
        }

        if root.certifiers.length == 0: Text {
            text: "No key in this store can certify. Create a key pair first.";
            color: Theme.warn;
            font-size: Theme.t-sm;
            wrap: word-wrap;
        }

        Divider { }

        HorizontalLayout {
            spacing: Theme.s2;
            alignment: end;
            Btn {
                text: "Cancel";
                variant: Variant.ghost;
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
            Btn {
                text: root.busy ? "Certifying…" : "Certify";
                glyph: Icons.certify;
                variant: Variant.primary;
                enabled: !root.busy && root.can-run;
                clicked => {
                    root.run(
                        root.certifier-index,
                        root.publishable,
                        root.introducer,
                        root.confidence,
                        root.password,
                    );
                }
            }
        }
    }
}

export component RevokeDialog inherits DialogShell {
    in property <string> target-name;
    /// Withdrawing a certification rather than revoking a whole key.
    in property <bool> certification;
    in property <bool> busy;
    callback run(int, string, string);

    property <string> password;
    property <string> message;
    property <int> reason: 0;

    title: root.certification ? "Withdraw certification" : "Revoke this key";
    subtitle: root.certification
        ? "Withdraw your certification of " + root.target-name
            + ". Their key is unaffected — only your endorsement of it is retracted."
        : "Revoke " + root.target-name
            + ". This cannot be undone, and anyone who already has the key keeps the "
            + "revocation forever. Publish it afterwards so others stop using the key.";
    card-width: 500px;

    VerticalLayout {
        spacing: Theme.s4;

        VerticalLayout {
            spacing: 6px;
            Text {
                text: "Reason";
                color: Theme.text-dim;
                font-size: Theme.t-sm;
            }
            // Mirrors Reason::ALL in rpgp-core, soft reasons first. The default
            // used to be "No reason given", which reads as neutral and is not:
            // OpenPGP treats it as a hard revocation, the same as a compromise.
            Select {
                label: "Reason for revocation";
                model: [
                    "No longer used",
                    "Replaced by a newer key",
                    "Secret key may be compromised",
                    "No reason given (treated as compromised)",
                ];
                enabled: !root.busy;
                current: root.reason;
                changed(index) => { root.reason = index; }
            }
            // The two hard reasons are the last two, by construction of
            // Reason::ALL, so this stays right if their labels change.
            if root.reason >= 2: Text {
                text: "This is a hard revocation: signatures this key made in the past "
                    + "stop counting too. Choose \"No longer used\" or \"Replaced\" "
                    + "if the key was never exposed.";
                color: Theme.warn;
                font-size: Theme.t-sm;
                wrap: word-wrap;
            }
        }

        Field {
            placeholder: "Note for whoever reads this later (optional)";
            enabled: !root.busy;
            edited(text) => { root.message = text; }
        }

        Field {
            placeholder: "Passphrase for the key (if any)";
            secret: true;
            enabled: !root.busy;
            edited(text) => { root.password = text; }
        }

        Divider { }

        HorizontalLayout {
            spacing: Theme.s2;
            alignment: end;
            Btn {
                text: "Cancel";
                variant: Variant.ghost;
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
            Btn {
                text: root.busy
                    ? "Working…"
                    : (root.certification ? "Withdraw certification" : "Revoke key");
                glyph: Icons.revoke;
                variant: Variant.danger;
                enabled: !root.busy;
                clicked => { root.run(root.reason, root.message, root.password); }
            }
        }
    }
}

export component DeleteDialog inherits DialogShell {
    in property <string> target-name;
    /// Whether the store holds this certificate's secret half. The whole point
    /// of the dialog: deleting someone else's public certificate is a tidying
    /// operation, deleting your own key is destroying the only copy.
    in property <bool> has-secret;
    in property <bool> has-revocation;
    in property <bool> busy;
    callback run();

    /// Typing the key ID is the confirmation for a secret key. A second button
    /// press is not a decision, it is a reflex; retyping something forces the
    /// user to look at *which* key this is.
    in property <string> confirm-word;
    property <string> typed;
    property <bool> confirmed: !root.has-secret || root.typed == root.confirm-word;

    title: root.has-secret ? "Delete your key" : "Delete this certificate";
    subtitle: root.has-secret
        ? "Delete " + root.target-name + " and its secret key. Nothing signed with it can be "
            + "made again, and nothing encrypted to it can be opened again. rpgp has the only "
            + "copy unless you exported one."
        : "Remove " + root.target-name + " from this store. Only your local copy goes; their "
            + "key is unaffected, and you can import it again later.";
    card-width: 500px;

    VerticalLayout {
        spacing: Theme.s4;

        if root.has-secret && !root.has-revocation: Text {
            text: "There is no revocation certificate for this key. If it was ever published, "
                + "deleting it here leaves no way to tell anyone to stop using it.";
            color: Theme.danger;
            font-size: Theme.t-sm;
            wrap: word-wrap;
        }

        if root.has-secret && root.has-revocation: Text {
            text: "The revocation certificate is kept, so a published key can still be "
                + "retracted afterwards.";
            color: Theme.text-dim;
            font-size: Theme.t-sm;
            wrap: word-wrap;
        }

        if root.has-secret: VerticalLayout {
            spacing: 6px;
            Text {
                text: "Type " + root.confirm-word + " to confirm";
                color: Theme.text-dim;
                font-size: Theme.t-sm;
            }
            Field {
                placeholder: root.confirm-word;
                enabled: !root.busy;
                edited(text) => { root.typed = text; }
            }
        }

        Divider { }

        HorizontalLayout {
            spacing: Theme.s2;
            alignment: end;
            Btn {
                text: "Cancel";
                variant: Variant.ghost;
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
            Btn {
                text: root.busy ? "Deleting…" : (root.has-secret ? "Delete key" : "Delete");
                glyph: Icons.trash;
                variant: Variant.danger;
                enabled: !root.busy && root.confirmed;
                clicked => { root.run(); }
            }
        }
    }
}

export component NotepadDialog inherits DialogShell {
    in property <[RecipientRow]> recipients;
    in property <[string]> signers;
    in property <int> chosen-recipients;
    in property <string> output;
    in property <[SignatureRow]> signatures;
    in property <string> result;
    in property <int> result-tone;
    in property <bool> busy;
    callback toggle-recipient(int);
    /// Narrows the list below. The count above stays over every recipient, so
    /// filtering can never look like it deselected someone.
    callback filter-recipients(string);
    /// action: 0 sign, 1 encrypt, 2 sign and encrypt, 3 decrypt or verify
    callback run(int, string, int, string, string);
    callback copy-output();
    /// Set briefly after a copy, so the button can confirm itself.
    in property <bool> copied: false;

    property <string> password;
    /// Symmetric passphrase. On the way out it encrypts for anyone holding it;
    /// on the way in `password` already serves that purpose, so this is only
    /// offered when encrypting.
    property <string> secret;
    property <int> signer-index: 0;

    title: "Notepad";
    subtitle: "Work on text directly instead of files. Paste a message to "
        + "decrypt or verify it, or type one to sign or encrypt.";
    card-width: 820px;

    VerticalLayout {
        spacing: Theme.s3;

        HorizontalLayout {
            spacing: Theme.s3;

            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;
                Text {
                    text: "Input";
                    color: Theme.text-dim;
                    font-size: Theme.t-sm;
                }
                editor := TextArea {
                    height: 200px;
                    placeholder: "Type, or paste an OpenPGP message…";
                    enabled: !root.busy;
                }
            }

            VerticalLayout {
                spacing: 6px;
                width: 260px;
                HorizontalLayout {
                    Text {
                        text: "Recipients";
                        color: Theme.text-dim;
                        font-size: Theme.t-sm;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.chosen-recipients == 0
                            ? "none" : "\{root.chosen-recipients}";
                        color: Theme.text-faint;
                        font-size: Theme.t-sm;
                    }
                }
                Field {
                    placeholder: "Filter by name, e-mail or fingerprint";
                    glyph: Icons.search;
                    edited(text) => { root.filter-recipients(text); }
                }

                Rectangle {
                    // Flexible rather than a fixed 200px: the card is clamped
                    // to the window, so a list that cannot give ground pushes
                    // the buttons off the bottom on a short screen. It shrinks
                    // to 110px before anything else has to.
                    min-height: 110px;
                    preferred-height: 200px;
                    vertical-stretch: 1;
                    background: Theme.surface-sunken;
                    border-radius: Theme.r-sm;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    if root.recipients.length == 0: Text {
                        text: "No one matches that.";
                        color: Theme.text-faint;
                        font-size: Theme.t-sm;
                        x: Theme.s3;
                        y: Theme.s3;
                    }
                    ListView {
                        for entry[index] in root.recipients: Rectangle {
                            height: 34px;
                            background: pick.has-hover ? Theme.hover : transparent;

                            // The row draws a tick box but is not one: without these a screen
                            // reader sees an unlabelled rectangle and cannot tell a chosen
                            // recipient from an unchosen one. Check declares the same set.
                            accessible-role: checkbox;
                            accessible-label: entry.label + ", " + entry.sublabel;
                            accessible-checkable: true;
                            accessible-checked: entry.selected;
                            accessible-action-default => { root.toggle-recipient(index); }
                            HorizontalLayout {
                                padding-left: Theme.s2;
                                padding-right: Theme.s2;
                                spacing: Theme.s2;
                                Rectangle {
                                    width: 15px;
                                    height: 15px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: entry.selected ? Theme.accent : Theme.surface;
                                    border-width: 1px;
                                    border-color: entry.selected ? Theme.accent : Theme.border-strong;
                                    if entry.selected: Icon {
                                        glyph: Icons.check;
                                        tint: Theme.accent-ink;
                                        width: 11px;
                                        height: 11px;
                                    }
                                }
                                Text {
                                    text: entry.label;
                                    color: Theme.text;
                                    font-size: Theme.t-sm;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                // Beside the name rather than under it: these
                                // rows are 34px and a second line would halve
                                // how many fit. It is what tells two keys for
                                // the same person apart, so it elides last.
                                Text {
                                    text: entry.sublabel;
                                    color: Theme.text-faint;
                                    font-size: Theme.t-xs;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            pick := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.toggle-recipient(index); }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.s2;
            if root.signers.length > 0: Select {
                label: "Sign as";
                model: root.signers;
                enabled: !root.busy;
                current: root.signer-index;
                changed(index) => { root.signer-index = index; }
            }
            Field {
                placeholder: "Key passphrase";
                secret: true;
                enabled: !root.busy;
                edited(text) => { root.password = text; }
            }
            Field {
                placeholder: "Or a password";
                secret: true;
                enabled: !root.busy;
                edited(text) => { root.secret = text; }
            }
        }

        if root.result != "": Rectangle {
            background: root.result-tone == 1 ? Theme.ok-soft
                : root.result-tone == 2 ? Theme.warn-soft : Theme.danger-soft;
            border-radius: Theme.r-md;
            height: banner.preferred-height;
            banner := VerticalLayout {
                padding: Theme.s3;
                spacing: Theme.s1;
                Text {
                    text: root.result;
                    color: root.result-tone == 1 ? Theme.ok
                        : root.result-tone == 2 ? Theme.warn : Theme.danger;
                    font-size: Theme.t-md;
                    font-weight: Theme.w-medium;
                    wrap: word-wrap;
                }
                for signature in root.signatures: Text {
                    // The notepad's banner is text rather than pills, so the
                    // SHA-1 caveat rides in the parenthesis beside the
                    // authentication verdict rather than as a badge of its own.
                    text: (signature.good ? "good signature — " : "BAD — ")
                        + (signature.good
                            ? signature.signer + " (" + signature.authentication
                                + (signature.sha1 ? ", SHA-1" : "") + ")"
                            : signature.detail);
                    color: Theme.text;
                    font-size: Theme.t-sm;
                    wrap: word-wrap;
                }
            }
        }

        if root.output != "": VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                Text {
                    text: "Output";
                    color: Theme.text-dim;
                    font-size: Theme.t-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                // A button rather than click-to-copy: clicking text should
                // place a cursor or start a selection, not fire a side effect
                // with no affordance and no confirmation.
                Btn {
                    text: root.copied ? "Copied" : "Copy";
                    glyph: root.copied ? Icons.check : Icons.file;
                    variant: Variant.ghost;
                    clicked => { root.copy-output(); }
                }
            }
            // Kept separate from the input rather than replacing it: pasting
            // ciphertext and having it overwritten by the plaintext loses the
            // thing you might still need.
            TextArea {
                height: 150px;
                text: root.output;
                enabled: false;
            }
        }

        Divider { }

        HorizontalLayout {
            spacing: Theme.s2;
            Btn {
                text: "Close";
                variant: Variant.ghost;
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Btn {
                text: "Decrypt / Verify";
                glyph: Icons.unlock;
                enabled: !root.busy && editor.text != "";
                clicked => { root.run(3, editor.text, root.signer-index, root.password, root.secret); }
            }
            Btn {
                text: "Sign";
                glyph: Icons.pen-line;
                enabled: !root.busy && editor.text != "" && root.signers.length > 0;
                clicked => { root.run(0, editor.text, root.signer-index, root.password, root.secret); }
            }
            Btn {
                text: "Encrypt";
                glyph: Icons.lock;
                enabled: !root.busy && editor.text != ""
                    && (root.chosen-recipients > 0 || root.secret != "");
                clicked => { root.run(1, editor.text, root.signer-index, root.password, root.secret); }
            }
            Btn {
                text: "Sign & Encrypt";
                glyph: Icons.lock;
                variant: Variant.primary;
                enabled: !root.busy && editor.text != "" && root.signers.length > 0
                    && (root.chosen-recipients > 0 || root.secret != "");
                clicked => { root.run(2, editor.text, root.signer-index, root.password, root.secret); }
            }
        }
    }
}

export component DetailsDialog inherits DialogShell {
    in property <CertRow> cert;
    in property <[UserIdDetailRow]> user-ids;
    in property <[SubkeyRow]> subkeys;
    in property <[CertificationRow]> certifications;
    /// Our own key, so the lifecycle actions apply.
    in property <bool> owned: false;
    callback change-expiry();
    callback add-user-id();
    callback revoke-user-id(string);
    /// Forwarded to the window, which owns the clipboard.
    callback copy-value(string);
    callback revoke-subkey(string);

    title: root.cert.primary-user-id;
    // No subtitle. It said nothing the title did not, and this dialog is the
    // one that runs out of height: a key you own gains a Change button, an Add
    // user ID button and a Revoke control on every user ID and subkey, which
    // is what pushed it past the window. A decorative line is the cheapest
    // thing to give up.
    card-width: 720px;

    VerticalLayout {
        spacing: Theme.s4;

        // The body scrolls and the Close button does not. This dialog stacks
        // four sections whose length depends on the certificate — a key with
        // many user IDs, subkeys or certifications is simply taller than any
        // card, and the card is clamped to the window. Without this the button
        // was pushed past the bottom edge and clipped away.
        body := ScrollView {
            vertical-stretch: 1;
            // Asks for the full height of its contents, even though it can
            // scroll. A ScrollView's own preferred height is small, and the
            // card is sized from `content.preferred-height` — so without this
            // the card shrinks to fit the scroller rather than the other way
            // round, and the whole dialog becomes a letterbox.
            preferred-height: sections.preferred-height;
            min-height: 220px;
            viewport-width: self.visible-width;
            // Taller than the visible area is what gives the ScrollView
            // something to scroll; without it there is no scrollbar at all.
            viewport-height: max(self.visible-height, sections.preferred-height);

            sections := VerticalLayout {
                // Keeps content clear of the scrollbar, which the fluent style
                // draws over the right edge of the viewport rather than beside
                // it — without this the "primary" tag sits underneath it.
                padding-right: Theme.s4;
                spacing: Theme.s4;

        SectionLabel { text: "PRIMARY KEY"; }
        VerticalLayout {
            spacing: Theme.s2;
            FieldRow {
                label: "Fingerprint";
                value: root.cert.fingerprint-pretty;
                mono: true;
                copyable: true;
                copy => { root.copy-value(root.cert.fingerprint); }
            }
            FieldRow { label: "Algorithm"; value: root.cert.algorithm; mono: true; }
            FieldRow { label: "Created"; value: root.cert.created; mono: true; }
            HorizontalLayout {
                FieldRow {
                    label: "Expires";
                    value: root.cert.expires == "" ? "never" : root.cert.expires;
                    mono: true;
                    horizontal-stretch: 1;
                }
                if root.owned: Btn {
                    text: "Change…";
                    variant: Variant.ghost;
                    clicked => { root.change-expiry(); }
                }
            }
            FieldRow { label: "Usage"; value: root.cert.capabilities; mono: true; }
        }

        Divider { }

        HorizontalLayout {
            SectionLabel { text: "USER IDS"; horizontal-stretch: 1; }
            if root.owned: Btn {
                text: "Add…";
                variant: Variant.ghost;
                clicked => { root.add-user-id(); }
            }
        }
        VerticalLayout {
            spacing: Theme.s2;
            for uid in root.user-ids: uid-row := HorizontalLayout {
                spacing: Theme.s2;
                property <bool> copied: false;

                // The text column only, not the whole row: the pills and the
                // revoke button sit beside it and a row-wide target would take
                // clicks meant for them.
                accessible-role: button;
                accessible-label: "Copy user ID";
                accessible-description: uid.text;
                accessible-action-default => {
                    root.copy-value(uid.text);
                    uid-row.copied = true;
                    settle.running = true;
                }

                uid-copy := TouchArea {
                    horizontal-stretch: 1;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.copy-value(uid.text);
                        uid-row.copied = true;
                        settle.running = true;
                    }

                    settle := Timer {
                        interval: 1600ms;
                        running: false;
                        triggered => {
                            uid-row.copied = false;
                            self.running = false;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.s2;
                        VerticalLayout {
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                // A user ID is a machine value people compare
                                // character by character, like the fingerprint
                                // above it.
                                text: uid.text;
                                font-family: "Source Code Pro";
                                color: uid.revoked ? Theme.text-faint : Theme.text;
                                font-size: Theme.t-sm;
                                wrap: word-wrap;
                            }
                            Text {
                                text: uid.self-signed == ""
                                    ? "no self-signature"
                                    : "self-signed " + uid.self-signed;
                                color: Theme.text-faint;
                                font-size: Theme.t-xs;
                            }
                        }

                        VerticalLayout {
                            alignment: start;
                            Icon {
                                glyph: uid-row.copied ? Icons.check : Icons.file;
                                tint: uid-row.copied ? Theme.ok : Theme.text-faint;
                                width: 14px;
                                height: 14px;
                                opacity: uid-row.copied
                                    ? 1.0
                                    : (uid-copy.has-hover ? 1.0 : 0.0);
                                animate opacity { duration: Theme.fast; }
                            }
                        }
                    }
                }
                if uid.is-primary: Pill { text: "primary"; tone: Tone.accent; }
                if uid.revoked: Pill { text: "revoked"; tone: Tone.danger; }
                if root.owned && !uid.revoked && !uid.is-primary: Btn {
                    glyph: Icons.revoke;
                    // Icon-only and destructive: it named nothing at all, so
                    // the one control here worth being sure about was the one
                    // announced as an unlabelled button.
                    label: "Revoke user ID " + uid.text;
                    variant: Variant.ghost;
                    clicked => { root.revoke-user-id(uid.text); }
                }
            }
        }

        Divider { }

        SectionLabel { text: "SUBKEYS"; }
        if root.subkeys.length == 0: Text {
            text: "This certificate has no subkeys.";
            color: Theme.text-faint;
            font-size: Theme.t-sm;
        }
        VerticalLayout {
            spacing: Theme.s2;
            for key in root.subkeys: HorizontalLayout {
                spacing: Theme.s2;
                VerticalLayout {
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text {
                        text: key.fingerprint;
                        color: key.revoked ? Theme.text-faint : Theme.text;
                        font-size: Theme.t-sm;
                        font-family: "Source Code Pro";
                        overflow: elide;
                    }
                    Text {
                        text: key.algorithm + " · " + key.capabilities + " · created "
                            + key.created
                            + (key.expires == "" ? "" : " · until " + key.expires);
                        color: Theme.text-faint;
                        font-size: Theme.t-xs;
                    }
                }
                if key.has-secret: Pill { text: "secret"; tone: Tone.accent; }
                if key.revoked: Pill { text: "revoked"; tone: Tone.danger; }
                if root.owned && !key.revoked: Btn {
                    glyph: Icons.revoke;
                    label: "Revoke subkey " + key.fingerprint;
                    variant: Variant.ghost;
                    clicked => { root.revoke-subkey(key.fingerprint); }
                }
            }
        }

        Divider { }

        SectionLabel { text: "CERTIFICATIONS"; }
        if root.certifications.length == 0: Text {
            text: "Nobody has certified this identity.";
            color: Theme.text-faint;
            font-size: Theme.t-sm;
        }
        VerticalLayout {
            spacing: Theme.s2;
            for entry in root.certifications: HorizontalLayout {
                spacing: Theme.s2;
                Icon {
                    glyph: entry.is-revocation ? Icons.revoke
                        : (entry.good ? Icons.certify : Icons.cross);
                    tint: entry.is-revocation ? Theme.danger
                        : (entry.good ? Theme.ok : Theme.text-faint);
                    width: 14px;
                    height: 14px;
                    y: 2px;
                }
                VerticalLayout {
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text {
                        text: entry.by-me ? entry.certifier + " (you)" : entry.certifier;
                        color: Theme.text;
                        font-size: Theme.t-sm;
                        wrap: word-wrap;
                    }
                    Text {
                        text: entry.detail;
                        color: Theme.text-faint;
                        font-size: Theme.t-xs;
                        wrap: word-wrap;
                    }
                }
            }
        }

            }
        }

        Divider { }

        HorizontalLayout {
            alignment: end;
            Btn {
                text: "Close";
                variant: Variant.primary;
                clicked => { root.dismissed(); }
            }
        }
    }
}

export component LifecycleDialog inherits DialogShell {
    /// 0 change expiry, 1 add a user ID, 2 revoke a user ID
    in property <int> mode;
    in property <string> target;
    in property <bool> busy;
    /// mode, expiry-index, value, password, reason-index. The reason is
    /// meaningful for mode 4 (revoke a subkey) only.
    callback run(int, string, string, string, int);

    property <string> value;
    property <string> password;
    property <int> expiry: 0;
    property <int> reason: 0;

    title: root.mode == 0 ? "Change expiry"
        : root.mode == 1 ? "Add a user ID"
        : root.mode == 2 ? "Revoke a user ID"
        : root.mode == 4 ? "Revoke a subkey" : "Publish to a keyserver";
    subtitle: root.mode == 0
        ? "Extend, shorten, or remove the expiry date. An expiring key can be "
          + "brought back after it has lapsed."
        : root.mode == 1
            ? "Bind another name and address to this key. Publish the key again "
              + "afterwards so others see it."
            : root.mode == 2
                ? "Withdraw " + root.target + ". It stays on the key so anyone "
                  + "with an older copy can see it was retracted, rather than "
                  + "simply not knowing about it."
                : root.mode == 4
                    ? "Retract subkey " + root.target + ". The rest of the key "
                      + "keeps working — use this when one subkey's secret is "
                      + "exposed but the primary is not."
                    : "Upload this certificate to keys.openpgp.org. This cannot "
                      + "be undone: a keyserver has no delete, so the key and "
                      + "every user ID on it become public permanently. Only "
                      + "the public half is sent.";
    card-width: 480px;

    VerticalLayout {
        spacing: Theme.s3;

        if root.mode == 0: Select {
            label: "Expires";
            model: ["in 2 years", "in 1 year", "in 5 years", "never"];
            enabled: !root.busy;
            current: root.expiry;
            changed(index) => { root.expiry = index; }
        }

        if root.mode == 1: Field {
            placeholder: "Name <name@example.org>";
            enabled: !root.busy;
            edited(text) => { root.value = text; }
        }

        if root.mode == 2: Field {
            placeholder: "Note for whoever reads this later (optional)";
            enabled: !root.busy;
            edited(text) => { root.value = text; }
        }

        // Revoking a subkey is a revocation, and it needs a reason for the
        // same reason a whole-key revocation does: whether the subkey was
        // exposed decides whether its past signatures still count. Same
        // model as RevokeDialog, mirroring Reason::ALL.
        if root.mode == 4: Select {
            label: "Reason for revocation";
            model: [
                "No longer used",
                "Replaced by a newer key",
                "Secret key may be compromised",
                "No reason given (treated as compromised)",
            ];
            enabled: !root.busy;
            current: root.reason;
            changed(index) => { root.reason = index; }
        }
        if root.mode == 4 && root.reason >= 2: Text {
            text: "This is a hard revocation: signatures this subkey made in the past "
                + "stop counting too.";
            color: Theme.warn;
            font-size: Theme.t-sm;
            wrap: word-wrap;
        }
        if root.mode == 4: Field {
            placeholder: "Note for whoever reads this later (optional)";
            enabled: !root.busy;
            edited(text) => { root.value = text; }
        }

        if root.mode != 3: Field {
            placeholder: "Passphrase for the key (if any)";
            secret: true;
            enabled: !root.busy;
            edited(text) => { root.password = text; }
        }

        if root.mode == 3: Text {
            text: "Addresses on the key are only served once their owner "
                + "confirms them by e-mail.";
            color: Theme.text-dim;
            font-size: Theme.t-sm;
            wrap: word-wrap;
        }

        Divider { }

        HorizontalLayout {
            spacing: Theme.s2;
            alignment: end;
            Btn {
                text: "Cancel";
                variant: Variant.ghost;
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
            Btn {
                text: root.busy ? "Working…"
                    : root.mode == 0 ? "Set expiry"
                    : root.mode == 1 ? "Add user ID"
                    : root.mode == 2 ? "Revoke user ID"
                    : root.mode == 4 ? "Revoke subkey" : "Publish permanently";
                variant: root.mode >= 2 ? Variant.danger : Variant.primary;
                enabled: !root.busy && (root.mode != 1 || root.value != "");
                clicked => {
                    root.run(root.mode, "\{root.expiry}", root.value, root.password, root.reason);
                }
            }
        }
    }
}

export component LookupDialog inherits DialogShell {
    in property <[LookupRow]> results;
    in property <string> status;
    in property <bool> searched;
    in property <bool> busy;
    callback search(string);
    callback import-result(int);

    property <string> query;

    title: "Look up a certificate";
    subtitle: "Search the address's own domain first, then a keyserver. "
        + "Nothing is added to your store until you import it.";
    card-width: 560px;

    VerticalLayout {
        spacing: Theme.s3;

        HorizontalLayout {
            spacing: Theme.s2;
            Field {
                placeholder: "name@example.org, or a fingerprint";
                glyph: Icons.search;
                enabled: !root.busy;
                horizontal-stretch: 1;
                edited(text) => { root.query = text; }
                accepted => { root.search(root.query); }
            }
            Btn {
                text: root.busy ? "Searching…" : "Search";
                variant: Variant.primary;
                enabled: !root.busy && root.query != "";
                clicked => { root.search(root.query); }
            }
        }

        if root.status != "": Text {
            text: root.status;
            color: Theme.text-dim;
            font-size: Theme.t-sm;
            wrap: word-wrap;
        }

        if root.results.length > 0: VerticalLayout {
            spacing: Theme.s2;
            for entry[index] in root.results: HorizontalLayout {
                spacing: Theme.s3;

                Monogram {
                    initials: entry.initials;
                    tint: Theme.monograms[entry.tint-index];
                    size: 32px;
                    y: (parent.height - self.height) / 2;
                }

                VerticalLayout {
                    spacing: 1px;
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: entry.primary-user-id;
                        color: Theme.text;
                        font-size: Theme.t-md;
                        overflow: elide;
                    }
                    Text {
                        text: entry.fingerprint-pretty;
                        color: Theme.text-faint;
                        font-size: Theme.t-xs;
                        font-family: "Source Code Pro";
                        overflow: elide;
                    }
                }

                Pill {
                    text: entry.source;
                    tone: entry.source == "web key directory" ? Tone.ok : Tone.neutral;
                    y: (parent.height - self.height) / 2;
                }

                Btn {
                    text: entry.already-known ? "Update" : "Import";
                    variant: Variant.secondary;
                    enabled: !root.busy;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.import-result(index); }
                }
            }
        }

        Divider { }

        HorizontalLayout {
            alignment: end;
            Btn {
                text: "Close";
                variant: Variant.ghost;
                enabled: !root.busy;
                clicked => { root.dismissed(); }
            }
        }
    }
}

export component AboutDialog inherits DialogShell {
    in property <string> version;
    callback open-link();

    // No shell title or subtitle: the lockup below is the heading, and a text
    // "rPGP" above the wordmark would say the same thing twice.
    card-width: 460px;

    VerticalLayout {
        spacing: Theme.s4;

        VerticalLayout {
            spacing: Theme.s2;

            HorizontalLayout {
                spacing: Theme.s2;
                alignment: start;

                // Centred by a wrapper rather than by setting `y`, for the
                // reason given in the rail's copy of this lockup.
                VerticalLayout {
                    alignment: center;
                    Icon {
                        glyph: Icons.shield;
                        tint: Theme.accent;
                        width: 32px;
                        height: 32px;
                    }
                }

                Text {
                    text: "rPGP";
                    font-family: "Geo";
                    color: Theme.text;
                    font-size: Theme.t-wordmark;
                    vertical-alignment: center;
                }
            }

            Text {
                text: "An OpenPGP certificate manager. Version " + root.version + ".";
                color: Theme.text-dim;
                font-size: Theme.t-md;
                wrap: word-wrap;
            }
        }

        // The icon and the pointer cursor are the affordance: Slint has no
        // text decoration, so a link cannot be underlined.
        link := TouchArea {
            accessible-role: button;
            accessible-label: "Open rpgp.app";
            accessible-action-default => { root.open-link(); }
            height: 24px;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.open-link(); }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Icon {
                    glyph: Icons.link;
                    tint: link.has-hover ? Theme.accent-hover : Theme.accent;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "rpgp.app";
                    color: link.has-hover ? Theme.accent-hover : Theme.accent;
                    font-size: Theme.t-lg;
                    font-weight: Theme.w-medium;
                    vertical-alignment: center;
                }
            }
        }

        Divider { }

        SectionLabel { text: "LICENCE"; }
        VerticalLayout {
            spacing: 2px;
            Text {
                text: "Copyright © 2026 Jonathan Zeppettini";
                color: Theme.text;
                font-size: Theme.t-md;
            }
            Text {
                // Matches the MIT text in LICENSE; the year and holder there
                // are the authoritative ones.
                text: "MIT licensed.";
                color: Theme.text-dim;
                font-size: Theme.t-sm;
            }
        }

        SectionLabel { text: "BUILT WITH"; }
        VerticalLayout {
            spacing: Theme.s2;
            // Slint's royalty-free licence requires attribution in the
            // application, which is what this line is for. Removing it would
            // mean falling back to its GPLv3 or commercial terms.
            FieldRow { label: "Made with Slint"; value: "slint.dev — royalty-free desktop licence"; }
            FieldRow { label: "Sequoia-PGP"; value: "sequoia-pgp.org — LGPL-2.0-or-later"; }
            FieldRow { label: "Lucide"; value: "lucide.dev — ISC licence"; }
        }

        Divider { }

        HorizontalLayout {
            alignment: end;
            Btn {
                text: "Close";
                variant: Variant.primary;
                clicked => { root.dismissed(); }
            }
        }
    }
}
