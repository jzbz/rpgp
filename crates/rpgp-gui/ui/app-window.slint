import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon } from "theme.slint";
import {
    Btn, CertList, Check, Divider, Field, FieldRow, Monogram, Pill, RevocationBanner, RevokeOffer,
    ScopeTabs, SectionLabel, Select, StatusBar, Tone, TrustRootCheck, Variant,
} from "widgets.slint";
import { CertRow, CertificationRow, LookupRow, PendingRevocationRow, RecipientRow, SignatureRow, SubkeyRow, UserIdDetailRow, UserIdRow } from "types.slint";
import { AboutDialog, CertifyDialog, DecryptVerifyDialog, DetailsDialog, ImportRevocationDialog, KeygenDialog, LifecycleDialog, LookupDialog, NotepadDialog, DeleteDialog, RevokeDialog, SignEncryptDialog } from "dialogs.slint";

// A bare file import is how Slint registers a custom font; the family it
// declares ("Geo") is then usable as a font-family anywhere. Slint accepts
// only ttf/ttc/otf, so this is the site's WOFF2 converted, with the OFL text
// and the Reserved Font Name notice beside it.
import "fonts/geo.ttf";

// Machine values — fingerprints, key IDs — in a face chosen for telling 0 from
// O and 1 from l. Generic "monospace" resolves to whatever the system happens
// to ship, so the one place a character-by-character comparison actually
// matters looked different on every platform.
import "fonts/source-code-pro.ttf";

// The interface font, bundled rather than left to the system. Without it the
// default family is whatever fontconfig resolves, which is not the same thing
// twice: Noto Sans on a Fedora host, DejaVu Sans inside the Flatpak runtime.
// Two different faces meant two different text extents, so the same build
// laid its buttons out differently depending on how it was installed.
import "fonts/geist-regular.ttf";
import "fonts/geist-semibold.ttf";
import "fonts/geist-bold.ttf";

export { CertRow, CertificationRow, LookupRow, RecipientRow, SignatureRow, SubkeyRow, UserIdDetailRow, UserIdRow }

export component AppWindow inherits Window {
    title: "rPGP";
    // The window icon is a separate thing from the executable's icon resource,
    // and Windows does not fall back from one to the other: the .ico embedded by
    // build.rs is what Explorer draws for the file, while the title bar, the
    // taskbar button and Alt-Tab all read the icon set on the window itself.
    // Without this the app had a correct icon on disk and a blank placeholder
    // everywhere the user actually looks at it.
    icon: @image-url("../desktop/app.rpgp.rPGP-256.png");
    // Whether the toolbar shows its secondary actions as glyphs alone.
    //
    // Assigned from `changed width` rather than bound to it. A binding of the
    // form `compact: width < N` is a loop, and Slint says so: `compact` decides
    // the buttons' min-width, min-width decides the row's layout info, and the
    // layout info decides the width the binding just read. Slint's own warning
    // calls that deprecated and liable to panic at runtime. Assigning breaks the
    // circuit — the value is a fact about the window, not a function of what the
    // toolbar did with it.
    //
    // Spelled out, the row needs about 806px once the search field has given up
    // its 160px, and the sidebar takes 209px before that. The threshold sits
    // above the sum rather than on it: the button widths behind it are text
    // measurements that move with the font, and erring high costs a few labels
    // early where erring low restores the overlap this exists to prevent.
    property <bool> toolbar-compact: false;
    init => { root.toolbar-compact = root.width < 1070px; }
    changed width => { root.toolbar-compact = root.width < 1070px; }

    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 860px;
    min-height: 520px;
    // The test probes in testing/field-probe.slint import the same fonts and
    // set the same two defaults, so that the tests measure text as this
    // window lays it out. Change them together.
    default-font-family: "Geist";
    default-font-size: Theme.t-md;
    background: Theme.bg;

    // --- Certificate list -------------------------------------------------
    in property <[CertRow]> certs;
    in property <CertRow> detail;
    in property <bool> has-selection: false;
    in-out property <int> current-row: -1;
    in property <int> count-all: 0;
    in property <int> count-mine: 0;
    in property <int> count-others: 0;
    in-out property <int> scope: 0;
    in-out property <int> sort-by: 0;
    in property <string> status: "";
    in property <bool> busy: false;

    // Whether a dialog is open, and with it whether the controls behind its
    // scrim take any input.
    //
    // The dialogs are children of the window, not popups, and Slint's Tab
    // goes to any control that is on screen, covered or not, and wraps around
    // the whole window. So Tab walked out of a dialog to the rail, the toolbar
    // and the details pane, and Space pressed there acted behind the scrim:
    // tabbing past the notepad's last button to the rail's Sign / Encrypt
    // opened that dialog underneath it and replaced the notepad's ticked
    // recipients with its own, and Shift+Tab reached the details pane's Trust
    // root and SHA-1 boxes, each a write to the store on one key. Assistive
    // technology could activate any of them as well. Every control behind a
    // dialog is therefore disabled while one is open: a disabled control
    // takes no focus, so Tab goes round the dialog's own controls and no
    // others, and the app's widgets refuse assistive technology's actions
    // while disabled. They are drawn disabled too, under the scrim.
    //
    // That holds only while no dialog opens over another, since the one
    // under it is not disabled. None does from here: every opener is behind
    // the scrim, and the Details dialog closes as it opens the next. Rust
    // reads this before the one dialog it opens with no control pressed,
    // the question Import puts about a revocation certificate, which
    // Import's file dialog can bring on with another dialog open.
    out property <bool> dialog-open: root.keygen-open || root.signenc-open || root.verify-open
        || root.certify-open || root.delete-open || root.revoke-open
        || root.import-revocation-open || root.notepad-open || root.details-open
        || root.lifecycle-open || root.lookup-open || root.about-open;
    // What the controls behind the dialogs are enabled by: neither an
    // operation in flight nor a dialog over them.
    property <bool> live: !root.busy && !root.dialog-open;

    /// Why the operation the open dialog started has failed, which the dialog
    /// shows and announces; see DialogError. Rust sets it on a failure, along
    /// with the status line, and it is cleared here whenever a dialog opens
    /// or closes and whenever an operation starts, so that it never describes
    /// an earlier attempt or another dialog. That needs a dialog to open with
    /// no other open, or `dialog-open` would not change as it did. Rust opens
    /// none over another, and the Details dialog, which closes as it opens the
    /// next, runs nothing that could have failed. Bound only to the dialogs
    /// that have no result line of their own: Decrypt / Verify, the notepad
    /// and Lookup already say how a run went, failures included.
    in-out property <string> dialog-error: "";
    changed dialog-open => { root.dialog-error = ""; }
    changed busy => {
        if (root.busy) {
            root.dialog-error = "";
        }
    }

    callback refresh();
    callback import-file();
    callback export-selected();
    callback filter-changed(string);
    callback scope-changed(int);
    callback sort-changed(int);
    callback row-selected(int);

    // --- New key pair -----------------------------------------------------
    in-out property <bool> keygen-open: false;
    callback generate-key(string, string, string, int, int, int);

    // --- Sign / Encrypt ---------------------------------------------------
    // Whether Sign / Encrypt and Decrypt ask where to save their output, as
    // they do inside a Flatpak, rather than writing it beside the input. The
    // output names below are then bare file names, the ones the save dialog
    // will offer.
    in property <bool> choose-outputs: false;
    in-out property <bool> signenc-open: false;
    in property <string> se-input: "";
    // Both are supplied so the dialog can preview the right one as the
    // encrypt/sign checkboxes change, without a round trip to Rust.
    in property <string> se-output-encrypt: "";
    in property <string> se-output-sign: "";
    in property <[RecipientRow]> se-recipients;
    in property <[string]> se-signers;
    // Each signer's key ID, which the Sign as list draws beside it.
    in property <[string]> se-signer-key-ids;
    in property <int> se-selected-count: 0;
    callback open-sign-encrypt();
    callback se-pick-input();
    callback se-toggle-recipient(int);
    callback se-run(bool, bool, int, string, string);

    // --- Decrypt / Verify -------------------------------------------------
    in-out property <bool> verify-open: false;
    in property <string> dv-input: "";
    in property <string> dv-data: "";
    in property <bool> dv-needs-data: false;
    in property <string> dv-output: "";
    in property <[SignatureRow]> dv-signatures;
    in property <string> dv-result: "";
    in property <int> dv-tone: 0;
    callback open-decrypt-verify();
    callback dv-pick-input();
    callback dv-pick-data();
    callback dv-run(string);

    // --- Certify / trust --------------------------------------------------
    in property <[CertificationRow]> detail-certifications;
    /// The selected row's certifications are still being read, on a worker,
    /// so an empty list says nothing yet.
    in property <bool> certifications-pending: false;
    in property <bool> can-certify: false;
    in-out property <bool> certify-open: false;
    in property <string> certify-target: "";
    in property <[UserIdRow]> certify-user-ids;
    in property <[string]> certify-certifiers;
    in property <[string]> certify-certifier-key-ids;
    in property <int> certify-chosen: 0;
    callback open-certify();
    callback certify-toggle-user-id(int);
    callback certify-run(int, bool, bool, int, string);
    callback toggle-trust-root();
    callback toggle-sha1-accepted();

    // --- Revocation -------------------------------------------------------
    in-out property <bool> delete-open: false;
    in property <string> delete-target: "";
    in property <bool> delete-has-secret: false;
    in property <bool> delete-has-revocation: false;
    in property <string> delete-confirm-word: "";

    in-out property <bool> revoke-open: false;
    /// The open dialog withdraws a certification rather than revoking a key.
    in property <bool> revoke-is-certification: false;
    /// The open dialog marks a key retired earlier as compromised.
    in property <bool> revoke-upgrade: false;
    in property <string> revoke-target: "";
    /// A revocation certificate that Import read, for one of the user's own
    /// keys, waiting for them to say whether to store it.
    in-out property <bool> import-revocation-open: false;
    in property <[PendingRevocationRow]> import-revocations;
    /// How many of those revoke the user's own keys.
    in property <int> import-revocation-yours: 0;
    /// A revocation certificate for the selected key is on disk.
    in property <bool> has-revocation-cert: false;
    /// We have certified this certificate and could withdraw that.
    in property <bool> can-withdraw: false;
    // --- Notepad ----------------------------------------------------------
    // Reuses the Sign / Encrypt recipient and signer models rather than
    // duplicating them; both are built from the same store contents.
    in-out property <bool> notepad-open: false;
    /// The whole of a run's output, which is what Copy copies. Not shown:
    /// see np-output-shown.
    in property <string> np-output: "";
    /// As much of np-output as the output box is given to lay out, which is
    /// all of it unless it is long; `show_np_output` in lib.rs says why.
    in property <string> np-output-shown: "";
    /// Said under the output box when it shows only the start.
    in property <string> np-output-note: "";
    in property <[SignatureRow]> np-signatures;
    in property <string> np-result: "";
    in property <int> np-tone: 0;
    in-out property <bool> details-open: false;
    in property <[UserIdDetailRow]> detail-user-ids;
    in property <[SubkeyRow]> detail-subkeys;
    callback open-details();

    // --- Key lifecycle ----------------------------------------------------
    in-out property <bool> lifecycle-open: false;
    in property <int> lifecycle-mode: 0;
    in property <string> lifecycle-target: "";
    // The key the dialog was opened for, set when it opens rather than bound to
    // `detail`, which can move while the dialog is up.
    in property <string> lifecycle-key-name: "";
    in property <string> lifecycle-key-id: "";
    // --- Network lookup ---------------------------------------------------
    in-out property <bool> lookup-open: false;
    in property <[LookupRow]> lookup-results;
    in property <string> lookup-status: "";
    in property <bool> lookup-searched: false;
    callback open-lookup();
    callback lookup-run(string);
    callback lookup-import(int);

    callback open-expiry();
    callback open-publish();
    callback open-add-user-id();
    callback open-revoke-user-id(string);
    callback open-revoke-subkey(string);
    callback lifecycle-run(int, string, string, string, int);

    callback open-notepad();
    /// Every way of closing the notepad. Rust empties what it showed, which
    /// these window properties would otherwise keep after the dialog is gone,
    /// and then closes it.
    callback close-notepad();
    callback np-run(int, string, int, string, string);
    callback np-copy();

    // --- About ------------------------------------------------------------
    in-out property <bool> about-open: false;
    in property <string> version: "";
    callback about-open-link();
    in property <bool> np-copied: false;

    callback open-revoke();
    /// Put a detail value on the clipboard.
    callback copy-value(string);
    callback filter-recipients(string);
    callback open-delete();
    callback delete-run();
    callback open-withdraw();
    callback revoke-run(int, string, string);
    callback import-revocation-run();
    callback save-revocation-cert();

    VerticalLayout {
        spacing: 0px;

    HorizontalLayout {
        spacing: 0px;

        // ---------------------------------------------------------------- rail
        Rectangle {
            width: 208px;
            background: Theme.surface-sunken;
            horizontal-stretch: 0;

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: Theme.border;
            }

            VerticalLayout {
                padding: Theme.s3;
                spacing: Theme.s2;

                HorizontalLayout {
                    padding-left: Theme.s2;
                    padding-top: Theme.s2;
                    padding-bottom: Theme.s3;
                    spacing: Theme.s2;

                    // Centred by a wrapper rather than by setting `y`. Inside
                    // a layout, `parent.height` is the row *including* its
                    // padding, which here is 8px top and 12px bottom — so
                    // centring against it put the glyph on a different axis
                    // from the text beside it, which centres within the
                    // content box the layout hands out.
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            glyph: Icons.shield;
                            tint: Theme.accent;
                            // Tracks the wordmark's size: a small shield
                            // beside a display face reads as an afterthought.
                            width: 32px;
                            height: 32px;
                        }
                    }

                    Text {
                        // rPGP, not rpgp: PGP is an initialism and reads as
                        // one. The binary, the crates and the paths stay
                        // lowercase — this is the wordmark, not an identifier.
                        text: "rPGP";
                        font-family: "Geo";
                        color: Theme.text;
                        // Geo is a display face and carries the extra size
                        // where the UI font would just look shouty. Still on
                        // the type scale rather than a one-off number.
                        font-size: Theme.t-wordmark;
                        font-weight: Theme.w-bold;
                        vertical-alignment: center;
                    }
                }

                ScopeTabs {
                    enabled: root.live;
                    scope <=> root.scope;
                    count-all: root.count-all;
                    count-mine: root.count-mine;
                    count-others: root.count-others;
                    scope-changed(index) => { root.scope-changed(index); }
                }

                Rectangle { vertical-stretch: 1; }

                Divider { }

                VerticalLayout {
                    padding: Theme.s2;
                    spacing: Theme.s1;
                    SectionLabel { text: "OPERATIONS"; }
                }

                Btn {
                    text: "Sign / Encrypt";
                    glyph: Icons.lock;
                    variant: Variant.ghost;
                    wide: true;
                    enabled: root.live;
                    clicked => { root.open-sign-encrypt(); }
                }
                Btn {
                    text: "Decrypt / Verify";
                    glyph: Icons.unlock;
                    variant: Variant.ghost;
                    wide: true;
                    enabled: root.live;
                    clicked => { root.open-decrypt-verify(); }
                }
                Btn {
                    text: "Notepad";
                    glyph: Icons.pen-line;
                    variant: Variant.ghost;
                    wide: true;
                    enabled: root.live;
                    clicked => { root.open-notepad(); }
                }
                Btn {
                    text: "About";
                    glyph: Icons.shield;
                    variant: Variant.ghost;
                    wide: true;
                    // Starts nothing, so an operation in flight leaves it be.
                    enabled: !root.dialog-open;
                    clicked => { root.about-open = true; }
                }
            }
        }

        // ------------------------------------------------------------- content
        VerticalLayout {
            spacing: 0px;

            // Toolbar
            //
            // Everything in this row used to be rigid — a 300px field, a 150px
            // select and five buttons that spelled themselves out — which came
            // to about 966px against the 971px the row gets at the default
            // window size. Five pixels of slack meant the first drag of the
            // window edge broke it. The field now gives way first, and the
            // three secondary actions drop to their glyphs before anything is
            // forced to overlap.
            toolbar := Rectangle {
                height: 58px;
                background: Theme.bg;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: parent.width;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: Theme.s4;
                    padding-right: Theme.s4;
                    spacing: Theme.s2;

                    Field {
                        placeholder: "Search name, e-mail or fingerprint";
                        glyph: Icons.search;
                        // Prefers 300px and never exceeds it, but a cramped row
                        // takes it down to 140px before touching the buttons —
                        // a search box is the one thing here that still works
                        // when it is half its ideal size.
                        min-width: 140px;
                        max-width: 300px;
                        horizontal-stretch: 1;
                        enabled: root.live;
                        y: (parent.height - self.height) / 2;
                        edited(text) => { root.filter-changed(text); }
                    }

                    Select {
                        label: "Sort by";
                        model: ["Mine first", "Name", "Newest", "Expiring soonest"];
                        width: 150px;
                        enabled: root.live;
                        current: root.sort-by;
                        y: (parent.height - self.height) / 2;
                        changed(index) => { root.sort-by = index; root.sort-changed(index); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Btn {
                        text: "Import";
                        compact: root.toolbar-compact;
                        glyph: Icons.arrow-in;
                        enabled: root.live;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.import-file(); }
                    }
                    Btn {
                        text: "Look up";
                        compact: root.toolbar-compact;
                        glyph: Icons.search;
                        enabled: root.live;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.open-lookup(); }
                    }
                    Btn {
                        text: "Export";
                        compact: root.toolbar-compact;
                        glyph: Icons.arrow-out;
                        enabled: root.has-selection && root.live;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.export-selected(); }
                    }
                    Btn {
                        glyph: Icons.refresh;
                        // Icon-only, so it carries its own name.
                        label: "Refresh the certificate list";
                        variant: Variant.ghost;
                        enabled: root.live;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.refresh(); }
                    }
                    Btn {
                        text: "New key pair";
                        glyph: Icons.plus;
                        variant: Variant.primary;
                        enabled: root.live;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.keygen-open = true; }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;

                // List
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.bg;

                    if root.certs.length == 0: VerticalLayout {
                        alignment: center;
                        spacing: Theme.s3;

                        Icon {
                            glyph: Icons.shield-large;
                            tint: Theme.text-faint;
                            width: 44px;
                            height: 44px;
                            x: (parent.width - self.width) / 2;
                        }
                        Text {
                            text: root.count-all == 0
                                ? "No certificates yet"
                                : "Nothing matches this search";
                            color: Theme.text;
                            font-size: Theme.t-lg;
                            font-weight: Theme.w-medium;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.count-all == 0
                                ? "Import a keyring, or create your first key pair."
                                : "Try a different name, e-mail or fingerprint.";
                            color: Theme.text-dim;
                            font-size: Theme.t-md;
                            horizontal-alignment: center;
                        }
                    }

                    if root.certs.length > 0: CertList {
                        certs: root.certs;
                        enabled: root.live;
                        current-row <=> root.current-row;
                        row-selected(index) => { root.row-selected(index); }
                    }
                }

                // Details. Always present, even with nothing selected: letting
                // it appear and disappear would reflow the list by 336px on
                // every click.
                Rectangle {
                    width: 336px;
                    background: Theme.surface;
                    horizontal-stretch: 0;

                    Rectangle {
                        x: 0;
                        width: 1px;
                        height: parent.height;
                        background: Theme.border;
                    }

                    if !root.has-selection: VerticalLayout {
                        alignment: center;
                        padding: Theme.s5;
                        spacing: Theme.s2;

                        Text {
                            text: "Nothing selected";
                            color: Theme.text-dim;
                            font-size: Theme.t-md;
                            font-weight: Theme.w-medium;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Pick a certificate to see its fingerprint, "
                                + "user IDs and what it can be used for.";
                            color: Theme.text-dim;
                            font-size: Theme.t-sm;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    // Scrolls: the trust section grows with however many
                    // certifications and user IDs a certificate has collected,
                    // and the actions at the bottom must stay reachable.
                    if root.has-selection: ScrollView {
                    VerticalLayout {
                        width: parent.visible-width;
                        padding: Theme.s5;
                        spacing: Theme.s4;
                        alignment: start;

                        HorizontalLayout {
                            spacing: Theme.s3;

                            Monogram {
                                initials: root.detail.initials;
                                tint: Theme.monograms[root.detail.tint-index];
                                size: 48px;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;

                                Text {
                                    text: root.detail.name == ""
                                        ? root.detail.primary-user-id
                                        : root.detail.name;
                                    color: Theme.text;
                                    font-size: Theme.t-lg;
                                    font-weight: Theme.w-bold;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.detail.email;
                                    color: Theme.text-dim;
                                    font-size: Theme.t-sm;
                                    overflow: elide;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Pill {
                                text: root.detail.validity;
                                tone: root.detail.validity == "valid" ? Tone.ok
                                    : root.detail.validity == "expired" ? Tone.warn
                                    : Tone.danger;
                            }
                            // An opted-in certificate summarises as "valid",
                            // because under its own policy it is. Saying only
                            // that would hide the asterisk the user themselves
                            // attached to it, so the pill rides alongside.
                            if root.detail.sha1-accepted: Pill {
                                text: "SHA-1";
                                tone: Tone.warn;
                                glyph: Icons.shield;
                            }
                            // "smartcard" alone, as in the list: which card
                            // is the Smartcard row's to say. With its serial
                            // this pill ran past the pane's edge.
                            if root.detail.card-serial != "": Pill {
                                text: "smartcard";
                                tone: Tone.accent;
                                glyph: Icons.key;
                            }

                            if root.detail.has-secret && root.detail.card-serial == "": Pill {
                                text: "secret key";
                                tone: Tone.accent;
                                glyph: Icons.key;
                            }
                        }

                        if root.detail.revocation != "": RevocationBanner {
                            reason: root.detail.revocation;
                            note: root.detail.revocation-note;
                        }

                        // Shown only when the opt-in is the actual question:
                        // either SHA-1 is what makes this certificate unusable,
                        // or the user has already accepted it. A certificate
                        // that is unusable for some other reason gets nothing
                        // here, because the checkbox would not help it.
                        if root.detail.sha1-blocked || root.detail.sha1-accepted: Rectangle {
                            background: Theme.warn-soft;
                            border-radius: Theme.r-md;
                            // Only spells out the height Slint gives a
                            // rectangle from the layout inside it, as it gives
                            // RevocationBanner above, which binds none: on
                            // Slint's testing backend, in a layout that starts
                            // its contents at the top as this pane's does, a
                            // copy of the notice is as tall without this
                            // binding as with it. Kept because no test reaches
                            // the notice itself to catch a change, the window
                            // being compiled without the debug information the
                            // testing backend finds elements by.
                            height: sha1-banner.preferred-height;

                            sha1-banner := VerticalLayout {
                                padding: Theme.s3;
                                spacing: Theme.s2;

                                HorizontalLayout {
                                    spacing: Theme.s2;
                                    Icon {
                                        glyph: Icons.shield;
                                        tint: Theme.warn;
                                        y: 1px;
                                    }
                                    Text {
                                        text: root.detail.sha1-accepted
                                            ? "You accept SHA-1 from this certificate. Its signatures can be checked, but a good result shows only that this key was involved — not that its holder approved what you are reading."
                                            : "This certificate signs itself with SHA-1, which is old enough to be forgeable, so none of it can be checked. Keys certified before about 2010 are often like this. You can accept SHA-1 from this one certificate to read its signatures.";
                                        color: Theme.warn;
                                        font-size: Theme.t-sm;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                }

                                Check {
                                    text: "Accept SHA-1 from this certificate";
                                    checked: root.detail.sha1-accepted;
                                    enabled: root.live;
                                    toggled => { root.toggle-sha1-accepted(); }
                                }

                                Text {
                                    text: "Applies to checking signatures and nothing else. This certificate can still never be verified through the web of trust, act as a trust root, or vouch for anyone else — and rPGP will not encrypt to it.";
                                    color: Theme.text-dim;
                                    font-size: Theme.t-sm;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Divider { }

                        SectionLabel { text: "CERTIFICATE"; }

                        VerticalLayout {
                            spacing: Theme.s3;

                            // Copying starts no operation, so only a dialog
                            // over them turns these off.
                            FieldRow {
                                label: "Fingerprint";
                                value: root.detail.fingerprint-pretty;
                                mono: true;
                                copyable: true;
                                enabled: !root.dialog-open;
                                copy => { root.copy-value(root.detail.fingerprint); }
                            }
                            FieldRow {
                                label: "Key ID";
                                value: root.detail.key-id;
                                mono: true;
                                copyable: true;
                                enabled: !root.dialog-open;
                                copy => { root.copy-value(self.value); }
                            }
                            if root.detail.card-serial != "": FieldRow {
                                label: "Smartcard";
                                value: root.detail.card-serial;
                                mono: true;
                                copyable: true;
                                enabled: !root.dialog-open;
                                copy => { root.copy-value(self.value); }
                            }
                            FieldRow {
                                label: "Algorithm";
                                value: root.detail.algorithm;
                                mono: true;
                            }
                            FieldRow { label: "Created"; value: root.detail.created; mono: true; }
                            FieldRow {
                                label: "Expires";
                                value: root.detail.expires == "" ? "never" : root.detail.expires;
                                mono: true;
                            }
                            FieldRow {
                                label: "Usage";
                                value: root.detail.capabilities;
                                mono: true;
                            }
                            FieldRow {
                                label: "User IDs";
                                value: root.detail.user-ids;
                                mono: true;
                                copyable: true;
                                enabled: !root.dialog-open;
                                copy => { root.copy-value(self.value); }
                            }
                        }

                        Divider { }

                        SectionLabel { text: "TRUST"; }

                        Text {
                            text: root.detail.authentication == "verified"
                                ? "The web of trust confirms this identity."
                                : root.detail.authentication == "partly verified"
                                    ? "Some evidence for this identity, but not enough to rely on."
                                    : "Nothing vouches for this identity yet.";
                            color: Theme.text-dim;
                            font-size: Theme.t-sm;
                            wrap: word-wrap;
                        }

                        TrustRootCheck {
                            cert: root.detail;
                            // Held, as for an operation in flight, while a
                            // dialog is over it too.
                            busy: !root.live;
                            toggled => { root.toggle-trust-root(); }
                        }

                        if root.detail-certifications.length == 0: Text {
                            text: root.certifications-pending
                                ? "Reading certifications…" : "No certifications.";
                            color: Theme.text-dim;
                            font-size: Theme.t-sm;
                        }

                        for entry in root.detail-certifications: HorizontalLayout {
                            spacing: Theme.s2;
                            alignment: start;

                            Icon {
                                glyph: entry.is-revocation ? Icons.revoke
                                    : (entry.good ? Icons.certify : Icons.cross);
                                tint: entry.is-revocation ? Theme.danger
                                    : (entry.good ? Theme.ok : Theme.text-faint);
                                width: 14px;
                                height: 14px;
                                y: 2px;
                            }

                            VerticalLayout {
                                spacing: 1px;
                                horizontal-stretch: 1;
                                Text {
                                    text: entry.by-me ? entry.certifier + " (you)" : entry.certifier;
                                    color: Theme.text;
                                    font-size: Theme.t-sm;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: entry.detail;
                                    color: Theme.text-dim;
                                    font-size: Theme.t-xs;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Divider { }

                        VerticalLayout {
                            spacing: Theme.s2;

                            Btn {
                                text: "Certify identity…";
                                glyph: Icons.certify;
                                variant: Variant.primary;
                                wide: true;
                                enabled: root.live && root.can-certify && !root.detail.has-secret;
                                clicked => { root.open-certify(); }
                            }

                            if root.can-withdraw: Btn {
                                text: "Withdraw my certification…";
                                glyph: Icons.revoke;
                                variant: Variant.ghost;
                                wide: true;
                                enabled: root.live;
                                clicked => { root.open-withdraw(); }
                            }

                            Btn {
                                text: "Publish to keyserver…";
                                glyph: Icons.arrow-out;
                                variant: Variant.ghost;
                                wide: true;
                                enabled: root.live && root.detail.has-secret;
                                clicked => { root.open-publish(); }
                            }

                            if root.has-revocation-cert: Btn {
                                text: "Save revocation certificate…";
                                glyph: Icons.arrow-out;
                                variant: Variant.ghost;
                                wide: true;
                                enabled: root.live;
                                clicked => { root.save-revocation-cert(); }
                            }

                            if RevokeOffer.shown(root.detail): Btn {
                                text: RevokeOffer.label(root.detail);
                                glyph: Icons.revoke;
                                variant: Variant.danger;
                                wide: true;
                                enabled: root.live;
                                clicked => { root.open-revoke(); }
                            }

                                Btn {
                                    text: "Delete…";
                                    glyph: Icons.trash;
                                    variant: Variant.danger;
                                    wide: true;
                                    enabled: root.live;
                                    clicked => { root.open-delete(); }
                                }

                                Btn {
                                    text: "All details…";
                                    glyph: Icons.file;
                                    variant: Variant.ghost;
                                    wide: true;
                                    enabled: root.live;
                                    clicked => { root.open-details(); }
                                }

                            HorizontalLayout {
                                spacing: Theme.s2;
                                Btn {
                                    text: "Export…";
                                    glyph: Icons.arrow-out;
                                    enabled: root.live;
                                    clicked => { root.export-selected(); }
                                }
                                Btn {
                                    text: "Encrypt to…";
                                    glyph: Icons.lock;
                                    enabled: root.live;
                                    clicked => { root.open-sign-encrypt(); }
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
    }

        // Status bar, spanning the rail as well as the content column.
        StatusBar {
            text: root.status;
            busy: root.busy;
            announce: !root.dialog-open;
        }
    }

    if root.keygen-open: KeygenDialog {
        busy: root.busy;
        error: root.dialog-error;
        dismissed => { root.keygen-open = false; }
        accepted(name, email, password, key-type, expiry, standard) => {
            root.generate-key(name, email, password, key-type, expiry, standard);
        }
    }

    if root.signenc-open: SignEncryptDialog {
        busy: root.busy;
        error: root.dialog-error;
        input-path: root.se-input;
        choose-output: root.choose-outputs;
        output-encrypt: root.se-output-encrypt;
        output-sign: root.se-output-sign;
        recipients: root.se-recipients;
        signers: root.se-signers;
        signer-key-ids: root.se-signer-key-ids;
        chosen-recipients: root.se-selected-count;
        dismissed => { root.signenc-open = false; }
        pick-input => { root.se-pick-input(); }
        toggle-recipient(index) => { root.se-toggle-recipient(index); }
        run(encrypt, sign, signer, password, secret) => {
            root.se-run(encrypt, sign, signer, password, secret);
        }
    }

    if root.details-open: DetailsDialog {
        cert: root.detail;
        user-ids: root.detail-user-ids;
        subkeys: root.detail-subkeys;
        certifications: root.detail-certifications;
        certifications-pending: root.certifications-pending;
        owned: root.detail.has-secret;
        dismissed => { root.details-open = false; }
        change-expiry => { root.details-open = false; root.open-expiry(); }
        add-user-id => { root.details-open = false; root.open-add-user-id(); }
        copy-value(text) => { root.copy-value(text); }
        revoke-user-id(uid) => { root.details-open = false; root.open-revoke-user-id(uid); }
        revoke-subkey(fpr) => { root.details-open = false; root.open-revoke-subkey(fpr); }
    }

    if root.lookup-open: LookupDialog {
        busy: root.busy;
        results: root.lookup-results;
        status: root.lookup-status;
        searched: root.lookup-searched;
        dismissed => { root.lookup-open = false; }
        search(query) => { root.lookup-run(query); }
        import-result(index) => { root.lookup-import(index); }
    }

    if root.lifecycle-open: LifecycleDialog {
        busy: root.busy;
        error: root.dialog-error;
        mode: root.lifecycle-mode;
        target: root.lifecycle-target;
        key-name: root.lifecycle-key-name;
        key-id: root.lifecycle-key-id;
        dismissed => { root.lifecycle-open = false; }
        run(mode, expiry, value, password, reason) => {
            root.lifecycle-run(mode, expiry, value, password, reason);
        }
    }

    if root.about-open: AboutDialog {
        version: root.version;
        dismissed => { root.about-open = false; }
        open-link => { root.about-open-link(); }
    }

    if root.notepad-open: NotepadDialog {
        filter-recipients(text) => { root.filter-recipients(text); }
        busy: root.busy;
        recipients: root.se-recipients;
        signers: root.se-signers;
        signer-key-ids: root.se-signer-key-ids;
        chosen-recipients: root.se-selected-count;
        output: root.np-output-shown;
        output-note: root.np-output-note;
        signatures: root.np-signatures;
        result: root.np-result;
        result-tone: root.np-tone;
        copied: root.np-copied;
        dismissed => { root.close-notepad(); }
        copy-output => { root.np-copy(); }
        toggle-recipient(index) => { root.se-toggle-recipient(index); }
        run(action, text, signer, password, secret) => {
            root.np-run(action, text, signer, password, secret);
        }
    }

    if root.certify-open: CertifyDialog {
        busy: root.busy;
        error: root.dialog-error;
        target-name: root.certify-target;
        user-ids: root.certify-user-ids;
        certifiers: root.certify-certifiers;
        certifier-key-ids: root.certify-certifier-key-ids;
        chosen-count: root.certify-chosen;
        dismissed => { root.certify-open = false; }
        toggle-user-id(index) => { root.certify-toggle-user-id(index); }
        run(certifier, publishable, introducer, confidence, password) => {
            root.certify-run(certifier, publishable, introducer, confidence, password);
        }
    }

    if root.delete-open: DeleteDialog {
        busy: root.busy;
        error: root.dialog-error;
        target-name: root.delete-target;
        has-secret: root.delete-has-secret;
        has-revocation: root.delete-has-revocation;
        confirm-word: root.delete-confirm-word;
        dismissed => { root.delete-open = false; }
        run => { root.delete-run(); }
    }

    if root.revoke-open: RevokeDialog {
        busy: root.busy;
        error: root.dialog-error;
        target-name: root.revoke-target;
        certification: root.revoke-is-certification;
        upgrade: root.revoke-upgrade;
        dismissed => { root.revoke-open = false; }
        run(reason, message, password) => { root.revoke-run(reason, message, password); }
    }

    if root.import-revocation-open: ImportRevocationDialog {
        busy: root.busy;
        error: root.dialog-error;
        revocations: root.import-revocations;
        yours: root.import-revocation-yours;
        dismissed => { root.import-revocation-open = false; }
        run => { root.import-revocation-run(); }
    }

    if root.verify-open: DecryptVerifyDialog {
        busy: root.busy;
        input-path: root.dv-input;
        data-path: root.dv-data;
        needs-data: root.dv-needs-data;
        choose-output: root.choose-outputs;
        output-path: root.dv-output;
        signatures: root.dv-signatures;
        result: root.dv-result;
        result-tone: root.dv-tone;
        dismissed => { root.verify-open = false; }
        pick-input => { root.dv-pick-input(); }
        pick-data => { root.dv-pick-data(); }
        run(password) => { root.dv-run(password); }
    }
}
