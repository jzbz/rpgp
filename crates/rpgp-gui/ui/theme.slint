import { Palette } from "std-widgets.slint";

// One source of truth for colour, spacing and type.
//
// The app follows the system light/dark setting but not a platform *style*:
// Slint's native style would draw cupertino widgets on macOS and fluent ones on
// Linux and Windows, and the app would look like two different products.
// Everything visible here is drawn by this design system, so rpgp looks like
// itself on every platform and takes only the window frame from the one it
// runs on. The font is the bundled Geist, which AppWindow sets as its default
// family, and the scrollbars are std-widgets' fluent ones everywhere, as
// build.rs pins that style.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Surfaces, back to front.
    out property <brush> bg: dark ? #131519 : #f5f6f9;
    out property <brush> surface: dark ? #1a1d23 : #ffffff;
    out property <brush> surface-sunken: dark ? #16181d : #eef0f4;
    out property <brush> hover: dark ? #ffffff0d : #0000000a;
    out property <brush> pressed: dark ? #ffffff1a : #00000014;
    out property <brush> selected: dark ? #6f8dff24 : #3457dc14;
    out property <brush> border: dark ? #272b33 : #e4e7ee;
    out property <brush> border-strong: dark ? #363c47 : #ccd2de;
    out property <brush> scrim: dark ? #000000b8 : #1b1f2799;

    // Ink.
    out property <brush> text: dark ? #e8eaef : #161a21;
    // The faintest ink for anything that has to be read: at least 4.7:1 on
    // every surface above, with a selected or hovered row or the warn-soft
    // banner laid over it, in either theme. WCAG asks 4.5:1 of text this
    // small, and the tests hold the theme to it.
    out property <brush> text-dim: dark ? #99a1b0 : #5c6470;
    // Under 4.5:1 on every surface, 2.4 to 3.8:1, so only for what the eye
    // may pass over: a placeholder, a count, a section heading, the text of
    // something a pill beside it says is revoked, and glyphs. Explanations
    // and details belong in text-dim. This used to carry them as well, the
    // limits of the SHA-1 opt-in among them, at under 3:1 in the light theme.
    out property <brush> text-faint: dark ? #6b7385 : #8b93a0;

    // Accent.
    out property <brush> accent: dark ? #6f8dff : #3457dc;
    out property <brush> accent-hover: dark ? #86a0ff : #2a48c0;
    // The label on a filled button, and the tick or selected text on an accent
    // fill. White on the light theme's deep fills. The dark theme's fills are
    // light, and white came to 2.4 to 3.0:1 on them, the red of Delete key the
    // least; the dark background's own colour comes to 6.0 to 8.8:1.
    out property <brush> accent-ink: dark ? #131519 : #ffffff;
    out property <brush> accent-soft: dark ? #6f8dff26 : #3457dc14;

    // Status. Each has a soft companion for pill backgrounds.
    out property <brush> ok: dark ? #4ed6a1 : #0f7a58;
    out property <brush> ok-soft: dark ? #4ed6a11f : #0f7a5814;
    out property <brush> warn: dark ? #f0b264 : #9a5c08;
    out property <brush> warn-soft: dark ? #f0b2641f : #9a5c0814;
    out property <brush> danger: dark ? #ff8098 : #c22a46;
    // A danger button under the pointer: the step from `danger` that
    // accent-hover takes from `accent`, so that a destructive button is still
    // red while it is being pressed.
    out property <brush> danger-hover: dark ? #ff94a8 : #a5243c;
    out property <brush> danger-soft: dark ? #ff80981f : #c22a4614;

    // Monogram tints, indexed by a hash of the fingerprint so a certificate
    // keeps the same colour between sessions.
    out property <[color]> monograms: dark
        ? [#6f8dff, #4ed6a1, #f0b264, #ff8098, #b088f9, #56c2d6]
        : [#3457dc, #0f7a58, #9a5c08, #c22a46, #7c4dd0, #0d6d80];

    // Spacing scale. Everything in the app is a multiple of 4.
    out property <length> s1: 4px;
    out property <length> s2: 8px;
    out property <length> s3: 12px;
    out property <length> s4: 16px;
    out property <length> s5: 24px;
    out property <length> s6: 32px;

    out property <length> r-sm: 6px;
    out property <length> r-md: 10px;
    out property <length> r-lg: 14px;

    // Type scale.
    out property <length> t-xs: 11px;
    out property <length> t-sm: 12px;
    out property <length> t-md: 13px;
    out property <length> t-lg: 15px;
    out property <length> t-xl: 19px;
    out property <length> t-2xl: 25px;
    // The wordmark only. Larger than anything in the UI proper, which is the
    // point: it is a logotype in a display face, not a heading.
    out property <length> t-wordmark: 38px;

    out property <int> w-regular: 400;
    out property <int> w-medium: 550;
    out property <int> w-bold: 700;

    out property <duration> fast: 120ms;
}

// Lucide, ISC licensed — see icons/LICENSE. Every glyph is 24x24 on a 2px
// round-cap stroke, and `Icon` recolours it through the alpha channel, so the
// set follows the theme without a second copy per colour.
//
// The names here are the app's, not Lucide's: `arrow-in`/`arrow-out` because
// `import` and `export` are Slint keywords, and `key`/`file`/`unlock` because
// the call sites should not care which Lucide variant was chosen.
export global Icons {
    out property <image> plus: @image-url("icons/plus.svg");
    out property <image> arrow-in: @image-url("icons/download.svg");
    out property <image> arrow-out: @image-url("icons/upload.svg");
    out property <image> refresh: @image-url("icons/refresh-cw.svg");
    out property <image> lock: @image-url("icons/lock.svg");
    out property <image> unlock: @image-url("icons/lock-open.svg");
    out property <image> search: @image-url("icons/search.svg");
    out property <image> check: @image-url("icons/check.svg");
    out property <image> cross: @image-url("icons/x.svg");
    out property <image> key: @image-url("icons/key-round.svg");
    out property <image> file: @image-url("icons/file-text.svg");
    out property <image> users: @image-url("icons/users.svg");
    out property <image> certify: @image-url("icons/badge-check.svg");
    out property <image> revoke: @image-url("icons/ban.svg");
    out property <image> trash: @image-url("icons/trash-2.svg");
    out property <image> pen-line: @image-url("icons/pen-line.svg");
    out property <image> link: @image-url("icons/external-link.svg");
    out property <image> introducer: @image-url("icons/user-check.svg");
    out property <image> shield: @image-url("icons/shield.svg");
    out property <image> chevron-down: @image-url("icons/chevron-down.svg");
    // A 2px stroke scales to nearly 4px at the 44px empty-state size, so that
    // one use gets a thinned copy.
    out property <image> shield-large: @image-url("icons/shield-large.svg");
}

export component Icon inherits Image {
    in property <image> glyph;
    in property <brush> tint: Theme.text;

    source: root.glyph;
    // colorize treats the SVG as an alpha mask and paints it in `tint`.
    colorize: root.tint;
    image-fit: contain;
    width: 16px;
    height: 16px;
}
