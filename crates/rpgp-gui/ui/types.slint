// Structs shared with Rust. Everything here is pre-formatted by rpgp-gui's
// `to_row` helpers: the UI never parses or formats a value itself.

export struct CertRow {
    fingerprint: string,
    fingerprint-pretty: string,
    key-id: string,
    primary-user-id: string,
    name: string,
    email: string,
    user-ids: string,
    algorithm: string,
    created: string,
    expires: string,
    validity: string,
    capabilities: string,
    has-secret: bool,
    initials: string,
    // Index into Theme.monograms, derived from the fingerprint so a colour
    // stays with a certificate across sessions and across light/dark.
    tint-index: int,
    // Web-of-trust result: "verified", "partly verified" or "unverified".
    // Separate from `validity`, which is only about the certificate being
    // internally sound.
    authentication: string,
    is-trust-root: bool,
    // The certificate is unusable *because* its self-signatures are hashed
    // with SHA-1, so the opt-in below would actually make it verifiable.
    // False for a certificate that is unusable some other way, where offering
    // the opt-in would weaken the policy for no gain.
    sha1-blocked: bool,
    // The user has opted this certificate into SHA-1 verification. Widens what
    // verifies and nothing else — never what is trusted.
    sha1-accepted: bool,
    // Why the certificate was revoked; empty when it has not been.
    revocation: string,
    // Smartcard serial when gpg-agent signs for this key from a card.
    card-serial: string,
}

// One certification already on a certificate, flattened for display.
export struct CertificationRow {
    certifier: string,
    user-id: string,
    // "full · publishable · 2026-08-10", or why it could not be checked.
    detail: string,
    good: bool,
    by-me: bool,
    // This entry withdraws an earlier certification.
    is-revocation: bool,
}

// A user ID offered for certification, with its tick state.
export struct UserIdRow {
    text: string,
    selected: bool,
}

export struct RecipientRow {
    fingerprint: string,
    label: string,
    sublabel: string,
    initials: string,
    tint-index: int,
    selected: bool,
}

export struct SignatureRow {
    good: bool,
    signer: string,
    detail: string,
    /// Whether the signer's name has been authenticated through the web of
    /// trust — "verified", "partly verified" or "unverified". A valid
    /// signature says the bytes came from that *key*; only this says the key
    /// belongs to the person the name claims.
    authentication: string,
    /// True only for a fully authenticated signer, so the reassuring styling
    /// is reserved for the case that has earned it.
    authenticated: bool,
    /// SHA-1 was load-bearing in accepting this signature. A good signature
    /// carrying this establishes that the signer's key was involved, not that
    /// the signer approved this document — SHA-1 collisions are practical.
    sha1: bool,
}

// A subkey row in the certificate details dialog.
export struct SubkeyRow {
    fingerprint: string,
    algorithm: string,
    created: string,
    expires: string,
    capabilities: string,
    revoked: bool,
    has-secret: bool,
}

// A user ID row in the certificate details dialog.
export struct UserIdDetailRow {
    text: string,
    is-primary: bool,
    revoked: bool,
    self-signed: string,
}

// A certificate found on the network, not yet in the store.
export struct LookupRow {
    primary-user-id: string,
    fingerprint-pretty: string,
    source: string,
    initials: string,
    tint-index: int,
    already-known: bool,
}
