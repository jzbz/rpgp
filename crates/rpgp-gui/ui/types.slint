// Structs shared with Rust. Everything here is pre-formatted by rpgp-gui's
// `to_row` helpers: the UI never parses or formats a value itself.

export struct CertRow {
    fingerprint: string,
    fingerprint-pretty: string,
    key-id: string,
    // The user IDs, and the revocation's note below, are shown with every
    // character that draws nothing or moves the text around it written out,
    // "[U+202E]", by rpgp-gui's `display::text`. The Rust side keeps the
    // certificate's own text for everything that acts on it.
    primary-user-id: string,
    name: string,
    email: string,
    // One user ID a line.
    user-ids: string,
    algorithm: string,
    created: string,
    expires: string,
    validity: string,
    capabilities: string,
    has-secret: bool,
    initials: string,
    // Index into Theme.monograms, derived from the fingerprint so a colour
    // stays with a certificate across sessions and across light/dark.
    tint-index: int,
    // Web-of-trust result: "verified", "partly verified" or "unverified".
    // Separate from `validity`, which is only about the certificate being
    // internally sound.
    authentication: string,
    is-trust-root: bool,
    // A trust root whatever `is-trust-root` says, because its secret key was
    // generated here. A secret key that arrived by import is not one: it is a
    // root only while `is-trust-root` makes it one.
    implicit-root: bool,
    // The certificate is unusable *because* its self-signatures are hashed
    // with SHA-1, so the opt-in below would actually make it verifiable.
    // False for a certificate that is unusable some other way, where offering
    // the opt-in would weaken the policy for no gain.
    sha1-blocked: bool,
    // The user has opted this certificate into SHA-1 verification. Widens what
    // verifies and nothing else — never what is trusted.
    sha1-accepted: bool,
    // Why the certificate was revoked, in the app's words; empty when it has
    // not been.
    revocation: string,
    // The note left with that revocation, written by whoever signed it, and
    // shown as theirs rather than the app's; often empty.
    revocation-note: string,
    // That revocation is hard, so there is no harder one left to give. A key
    // revoked only softly can still be marked compromised.
    revocation-hard: bool,
    // The smartcard gpg-agent signs for this key from, when it is on one, by
    // the number `gpg -K` gives it: "0006 18132963" for an OpenPGP card.
    card-serial: string,
}

// A revocation read from a file and not yet stored, as the dialog that asks
// before storing it lists it.
export struct PendingRevocationRow {
    name: string,
    // The reason, and the note left with it, as the details pane will show
    // them.
    reason: string,
    note: string,
    // Hard: signatures the key made in the past stop counting too.
    hard: bool,
    // The user holds this key's secret half, in the store or in gpg-agent,
    // so it is their own.
    yours: bool,
}

// One certification already on a certificate, flattened for display.
export struct CertificationRow {
    certifier: string,
    user-id: string,
    // "full · publishable · 2026-08-10", then why it could not be checked
    // or, where it was, why it does not count: "since withdrawn" and the like.
    detail: string,
    good: bool,
    by-me: bool,
    // This entry withdraws an earlier certification.
    is-revocation: bool,
}

// A user ID offered for certification, with its tick state.
export struct UserIdRow {
    text: string,
    selected: bool,
}

export struct RecipientRow {
    fingerprint: string,
    // The name, or the whole user ID where there is none.
    label: string,
    // The address, or nothing.
    sublabel: string,
    // What tells two certificates with the same user ID apart, which the
    // address alone does not: a person's old and new key usually share it.
    key-id: string,
    initials: string,
    tint-index: int,
    selected: bool,
}

export struct SignatureRow {
    good: bool,
    signer: string,
    detail: string,
    /// Whether the signer's name has been authenticated through the web of
    /// trust — "verified", "partly verified" or "unverified". A valid
    /// signature says the bytes came from that *key*; only this says the key
    /// belongs to the person the name claims.
    authentication: string,
    /// True only for a fully authenticated signer, so the reassuring styling
    /// is reserved for the case that has earned it.
    authenticated: bool,
    /// SHA-1 was load-bearing in accepting this signature. A good signature
    /// carrying this establishes that the signer's key was involved, not that
    /// the signer approved this document — SHA-1 collisions are practical.
    ///
    /// Set on a bad signature too, for the one refusal it explains: a
    /// signature that needed SHA-1 from a certificate the user has not
    /// accepted SHA-1 from is reported bad, and `detail` names it.
    sha1: bool,
}

// A subkey row in the certificate details dialog.
export struct SubkeyRow {
    fingerprint: string,
    algorithm: string,
    created: string,
    expires: string,
    capabilities: string,
    revoked: bool,
    has-secret: bool,
}

// A user ID row in the certificate details dialog.
export struct UserIdDetailRow {
    // As shown and copied, with any hidden character written out.
    text: string,
    // As the certificate has it: what Revoke user ID names, and never shown.
    user-id: string,
    is-primary: bool,
    revoked: bool,
    self-signed: string,
}

// A certificate found on the network, not yet in the store.
export struct LookupRow {
    primary-user-id: string,
    fingerprint-pretty: string,
    source: string,
    initials: string,
    tint-index: int,
    already-known: bool,
}
