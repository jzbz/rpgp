// Test-only harness: small windows built from the app's own widgets and
// dialogs, so a Rust test can operate them and inspect what the accessibility
// tree publishes. Not part of the application.
import { Field, Btn, Check, Select, FieldRow, TextArea, TrustRootCheck } from "../widgets.slint";
import { CertList, RevocationBanner, ScopeTabs, StatusBar } from "../widgets.slint";
// The rule the details pane draws its Revoke button by, for a test to ask.
export { RevokeOffer } from "../widgets.slint";
import { SignEncryptDialog, CertifyDialog, NotepadDialog, DeleteDialog } from "../dialogs.slint";
import { KeygenDialog, DecryptVerifyDialog, RevokeDialog, LifecycleDialog } from "../dialogs.slint";
import { ImportRevocationDialog, DetailsDialog, LookupDialog } from "../dialogs.slint";
import { CertRow, PendingRevocationRow, RecipientRow, UserIdDetailRow, UserIdRow, SignatureRow } from "../types.slint";

// One passphrase Field and one ordinary Field.
export component FieldProbe inherits Window {
    in-out property <string> secret-text <=> pass-field.text;
    in-out property <string> plain-text <=> plain-field.text;

    width: 240px;
    height: 80px;

    VerticalLayout {
        pass-field := Field {
            placeholder: "Passphrase";
            secret: true;
        }
        plain-field := Field {
            placeholder: "Search";
        }
    }
}

// The interactive controls, so a test can ask what assistive technology would
// be told about each and whether it can operate them.
export component ControlProbe inherits Window {
    in-out property <int> clicks: 0;
    in-out property <int> toggles: 0;
    in-out property <int> copies: 0;
    // State the controls actually carry, so a test can move it and check the
    // accessibility tree followed. Without these the probe never changed state
    // and the tree's checked/value assertions were satisfied by the defaults —
    // they would have held against a hardcoded binding just as well.
    in-out property <bool> encrypt: false;
    in-out property <int> standard: 0;

    width: 500px;
    height: 400px;

    VerticalLayout {
        Btn { text: "Save"; clicked => { root.clicks += 1; } }
        // Icon-only and destructive: the case that used to announce nothing.
        Btn { label: "Revoke user ID alice"; clicked => { root.clicks += 1; } }
        Check {
            text: "Encrypt";
            checked: root.encrypt;
            toggled => {
                root.toggles += 1;
                root.encrypt = !root.encrypt;
            }
        }
        Select {
            label: "Standard";
            model: ["Modern", "Compatible"];
            current: root.standard;
            changed(index) => { root.standard = index; }
        }
        FieldRow {
            label: "Fingerprint";
            value: "ABCD 1234";
            mono: true;
            copyable: true;
            copy => { root.copies += 1; }
        }
        FieldRow { label: "Algorithm"; value: "Ed25519"; }
    }
}

// One of each widget from widgets.slint that has an `enabled`, all switched by
// one property, and a count of everything any of them did. The scope tabs, the
// certificate list and FieldRow's copy button have probes of their own below.
// Disabled has to mean inert however a control is reached — by an
// assistive-technology action, by a key sent to one that had focus before it
// was disabled, or through a list it had already opened — and a test reads
// the counts to see that nothing happened.
export component EnabledProbe inherits Window {
    in-out property <bool> live: true;
    in-out property <int> clicks: 0;
    in-out property <int> toggles: 0;
    in-out property <int> changes: 0;
    in-out property <int> edits: 0;

    width: 500px;
    height: 480px;

    VerticalLayout {
        Btn { text: "Run"; enabled: root.live; clicked => { root.clicks += 1; } }
        Check { text: "Sign"; enabled: root.live; toggled => { root.toggles += 1; } }
        Select {
            label: "Mode";
            model: ["Modern", "Compatible"];
            enabled: root.live;
            changed(index) => { root.changes += 1; }
        }
        Field { placeholder: "Name"; enabled: root.live; edited(text) => { root.edits += 1; } }
        TextArea {
            height: 80px;
            placeholder: "Message";
            enabled: root.live;
            edited(text) => { root.edits += 1; }
        }
    }
}

// The two selection lists, driven through the real dialogs rather than through
// a copy of their markup here: a probe that reproduced the rows would go on
// passing after the shipped rows lost their accessibility again. `busy` is
// the window's, so a test can check that a recipient row takes no toggle
// while a run is in flight.
//
// There is a key to sign with unless a test takes it away, as there is in a
// store holding one of the user's own keys: the signing passphrase field is
// there only then, and the passphrase test has to reach it. What Run is asked
// to do is kept, as the window's handler would receive it.
export component SelectionProbe inherits Window {
    in-out property <[RecipientRow]> recipients;
    in-out property <int> toggled-recipient: -1;
    in-out property <bool> busy: false;
    in-out property <string> error;
    in-out property <[string]> signers: ["Probe <probe@example.org>"];
    in-out property <[string]> signer-key-ids;
    in-out property <int> chosen-recipients: 0;
    in-out property <int> runs: 0;
    in-out property <bool> encrypted;
    in-out property <bool> signed;
    in-out property <length> probe-height: 720px;

    width: 620px;
    height: root.probe-height;

    SignEncryptDialog {
        width: 100%;
        height: 100%;
        input-path: "/tmp/message.txt";
        recipients: root.recipients;
        signers: root.signers;
        signer-key-ids: root.signer-key-ids;
        chosen-recipients: root.chosen-recipients;
        busy: root.busy;
        error: root.error;
        toggle-recipient(index) => { root.toggled-recipient = index; }
        run(encrypt, sign, signer, password, secret) => {
            root.encrypted = encrypt;
            root.signed = sign;
            root.runs += 1;
        }
    }
}

export component CertifyProbe inherits Window {
    in-out property <[UserIdRow]> user-ids;
    in-out property <[string]> certifiers;
    in-out property <[string]> certifier-key-ids;
    in-out property <int> toggled-user-id: -1;
    in-out property <string> error;
    in-out property <length> probe-height: 720px;

    width: 620px;
    height: root.probe-height;

    CertifyDialog {
        width: 100%;
        height: 100%;
        target-name: "Alice";
        user-ids: root.user-ids;
        certifiers: root.certifiers;
        certifier-key-ids: root.certifier-key-ids;
        error: root.error;
        toggle-user-id(index) => { root.toggled-user-id = index; }
    }
}

// The notepad carries a third copy of the recipient row, behind its own filter.
export component NotepadProbe inherits Window {
    in-out property <[RecipientRow]> recipients;
    // Empty unless a test sets them, so that the other tests find the notepad
    // as they always have: with no key to sign with, and no verdict.
    in-out property <[string]> signers;
    in-out property <[string]> signer-key-ids;
    in-out property <[SignatureRow]> signatures;
    in-out property <int> toggled-recipient: -1;
    in-out property <bool> busy: false;
    // Empty unless a test sets it. The output area exists only while there is
    // output, and it refuses typing, so it would fail the passphrase test,
    // which types into every field it finds, if it were there by default.
    in-out property <string> output;
    in-out property <string> result;

    width: 620px;
    height: 720px;

    NotepadDialog {
        width: 100%;
        height: 100%;
        recipients: root.recipients;
        signers: root.signers;
        signer-key-ids: root.signer-key-ids;
        signatures: root.signatures;
        output: root.output;
        result: root.result;
        result-tone: 3;
        busy: root.busy;
        toggle-recipient(index) => { root.toggled-recipient = index; }
    }
}

// The four passphrase-bearing dialogs the probes above do not reach. The other
// five passphrase fields live in SignEncryptDialog, CertifyDialog and
// NotepadDialog, which the selection probes already instantiate.
//
// The first two keep what their button hands over, and how often it was
// pressed, so that a test can tell a button that did nothing from one that
// was never reached.
export component KeygenProbe inherits Window {
    in-out property <int> runs: 0;
    in-out property <string> passphrase;
    // Settable, as in VerifyBannerProbe, so that a test can hold the dialog
    // to the height the app's smallest window leaves it.
    in-out property <length> probe-height: 720px;
    in-out property <string> error;

    width: 620px;
    height: root.probe-height;
    KeygenDialog {
        width: 100%;
        height: 100%;
        error: root.error;
        accepted(name, email, password, key-type, expiry, standard) => {
            root.passphrase = password;
            root.runs += 1;
        }
    }
}

export component DecryptProbe inherits Window {
    // The passphrase field is conditional on a file having been chosen.
    in-out property <string> input-path: "/tmp/message.txt";
    in-out property <int> runs: 0;
    in-out property <string> sent;

    width: 620px;
    height: 720px;
    DecryptVerifyDialog {
        width: 100%;
        height: 100%;
        input-path: root.input-path;
        run(password) => {
            root.sent = password;
            root.runs += 1;
        }
    }
}

// The Decrypt / Verify result banner, driven from Rust so a real renderer can
// be pointed at a failure long enough to wrap. The window height is settable
// because the card is capped at the window height, and a card that has hit that
// cap is laid out differently from one that has not.
export component VerifyBannerProbe inherits Window {
    in-out property <string> result;
    in-out property <[SignatureRow]> signatures;
    in-out property <length> probe-height: 720px;
    width: 620px;
    height: root.probe-height;
    DecryptVerifyDialog {
        width: 100%;
        height: 100%;
        input-path: "/tmp/message.txt";
        data-path: "/tmp/message.txt.sig";
        result: root.result;
        result-tone: 3;
        signatures: root.signatures;
    }
}

export component RevokeProbe inherits Window {
    in-out property <string> error;
    in-out property <length> probe-height: 720px;
    width: 620px;
    height: root.probe-height;
    RevokeDialog { width: 100%; height: 100%; target-name: "Alice"; error: root.error; }
}

// The Revoke dialog as it opens for a key retired earlier, to mark it
// compromised, reporting the reason it hands back: an index into Reason::ALL,
// which is what run_revoke reads it as.
export component RevokeUpgradeProbe inherits Window {
    in-out property <int> runs: 0;
    in-out property <int> reason: -1;

    width: 620px;
    height: 720px;

    RevokeDialog {
        width: 100%;
        height: 100%;
        target-name: "Alice";
        upgrade: true;
        run(reason, message, password) => {
            root.reason = reason;
            root.runs += 1;
        }
    }
}

// The dialog that asks before a revocation certificate for the user's own
// keys is stored, holding more revocations than fit in the window at the
// smallest size the app allows unless a test gives it others.
export component ImportRevocationProbe inherits Window {
    in-out property <int> runs: 0;
    in-out property <string> error;
    in-out property <[PendingRevocationRow]> revocations: [
        { name: "Me <me@example.org>", reason: "Secret key may be compromised", hard: true, yours: true },
        { name: "Me <me@work.example.org>", reason: "Secret key may be compromised", hard: true, yours: true },
        { name: "Ann <ann@example.org>", reason: "No longer used", hard: false, yours: false },
        { name: "Ben <ben@example.org>", reason: "No reason given (treated as compromised)", hard: true, yours: false },
        { name: "Cai <cai@example.org>", reason: "No reason given (treated as compromised)", hard: true, yours: false },
        { name: "Dee <dee@example.org>", reason: "No reason given (treated as compromised)", hard: true, yours: false },
        { name: "Eve <eve@example.org>", reason: "No reason given (treated as compromised)", hard: true, yours: false },
        { name: "Fay <fay@example.org>", reason: "No reason given (treated as compromised)", hard: true, yours: false },
    ];

    width: 860px;
    height: 520px;

    ImportRevocationDialog {
        width: 100%;
        height: 100%;
        yours: 2;
        error: root.error;
        revocations: root.revocations;
        run => { root.runs += 1; }
    }
}

export component LifecycleProbe inherits Window {
    in-out property <string> error;
    in-out property <length> probe-height: 720px;
    // Every mode but publish carries the passphrase field.
    in-out property <int> mode: 0;
    width: 620px;
    height: root.probe-height;
    LifecycleDialog { width: 100%; height: 100%; mode: root.mode; target: "Alice"; error: root.error; }
}

// Publish, the lifecycle mode that cannot be undone, so that a test can ask
// what its warning says about which key is going.
export component PublishProbe inherits Window {
    width: 620px;
    height: 720px;
    LifecycleDialog {
        width: 100%;
        height: 100%;
        mode: 3;
        key-name: "Alice <alice@example.org>";
        key-id: "0123456789ABCDEF";
    }
}

// The line under Sign / Encrypt and under Decrypt that says where the output
// goes, which inside a Flatpak says instead that Run will ask. Both dialogs
// take the flag and the names from Rust, so a test sets them here the way
// Rust does.
export component OutputProbe inherits Window {
    in-out property <bool> choose-output: false;
    in-out property <string> encrypted;
    in-out property <string> decrypted;

    width: 620px;
    height: 720px;

    SignEncryptDialog {
        width: 100%;
        height: 100%;
        input-path: "/tmp/message.txt";
        choose-output: root.choose-output;
        output-encrypt: root.encrypted;
    }
    DecryptVerifyDialog {
        width: 100%;
        height: 100%;
        input-path: "/tmp/message.txt.asc";
        choose-output: root.choose-output;
        output-path: root.decrypted;
    }
}

// The dialog in which a disabled button is the whole of the confirmation:
// until the key ID has been typed, Delete key has to do nothing however it is
// reached, and the same once a delete is under way. It counts the ways it is
// asked to close as well, since a delete under way cannot be called back.
export component DeleteProbe inherits Window {
    in-out property <bool> busy: false;
    in-out property <int> runs: 0;
    in-out property <int> dismissals: 0;
    in-out property <string> error;
    in-out property <length> probe-height: 720px;

    width: 620px;
    height: root.probe-height;

    DeleteDialog {
        width: 100%;
        height: 100%;
        target-name: "Alice <alice@example.org>";
        has-secret: true;
        has-revocation: true;
        confirm-word: "0123456789ABCDEF";
        busy: root.busy;
        error: root.error;
        run => { root.runs += 1; }
        dismissed => { root.dismissals += 1; }
    }
}

// The details pane's Trust root checkbox, given a certificate the way the
// window gives it `detail`. The pane itself lives in the window, which has no
// debug information to find it by, so this is the shipped component rather
// than a copy of its markup.
export component TrustRootProbe inherits Window {
    in-out property <CertRow> cert;
    in-out property <bool> busy: false;
    in-out property <int> toggles: 0;

    width: 360px;
    height: 160px;

    TrustRootCheck {
        cert: root.cert;
        busy: root.busy;
        toggled => { root.toggles += 1; }
    }
}

// The rail's scope tabs, as the window has them, switched off by `live` as the
// window switches them off while a dialog is open or an operation runs.
export component ScopeTabsProbe inherits Window {
    in-out property <bool> live: true;
    in-out property <int> scope: 0;
    in-out property <int> changes: 0;

    width: 240px;
    height: 160px;

    ScopeTabs {
        enabled: root.live;
        scope <=> root.scope;
        count-all: 3;
        count-mine: 1;
        count-others: 2;
        scope-changed(index) => { root.changes += 1; }
    }
}

// The certificate list, given more rows than it can show at once, keeping
// which row it last asked Rust to select and how often it asked.
export component CertListProbe inherits Window {
    in-out property <[CertRow]> certs;
    in-out property <int> current-row: -1;
    in-out property <bool> live: true;
    in-out property <int> selected: -1;
    in-out property <int> selections: 0;

    width: 600px;
    height: 400px;

    CertList {
        certs: root.certs;
        enabled: root.live;
        current-row <=> root.current-row;
        row-selected(index) => {
            root.selected = index;
            root.selections += 1;
        }
    }
}

// A row that can be copied beside one that cannot, as the details pane has
// them.
export component CopyProbe inherits Window {
    in-out property <bool> live: true;
    in-out property <int> copies: 0;

    width: 400px;
    height: 120px;

    VerticalLayout {
        FieldRow {
            label: "Fingerprint";
            value: "ABCD 1234";
            mono: true;
            copyable: true;
            enabled: root.live;
            copy => { root.copies += 1; }
        }
        FieldRow { label: "Algorithm"; value: "Ed25519"; }
    }
}

// The Details dialog for a key of the user's own with a second user ID, which
// is the one that carries a Revoke button beside its copy button.
export component DetailsProbe inherits Window {
    in-out property <string> copied;
    in-out property <int> copies: 0;
    in-out property <string> revoked;
    in-out property <[UserIdDetailRow]> user-ids: [
        {
            text: "Alice <alice@example.org>",
            user-id: "Alice <alice@example.org>",
            is-primary: true,
            self-signed: "2026-01-01",
        },
        {
            text: "Alice <alice@work.example>",
            user-id: "Alice <alice@work.example>",
            self-signed: "2026-01-01",
        },
    ];

    width: 760px;
    height: 720px;

    DetailsDialog {
        width: 100%;
        height: 100%;
        owned: true;
        cert: {
            primary-user-id: "Alice <alice@example.org>",
            fingerprint: "0123456789ABCDEF0123456789ABCDEF01234567",
            fingerprint-pretty: "0123 4567 89AB CDEF 0123  4567 89AB CDEF 0123 4567",
            key-id: "89ABCDEF01234567",
            algorithm: "Ed25519",
        };
        user-ids: root.user-ids;
        copy-value(text) => {
            root.copied = text;
            root.copies += 1;
        }
        revoke-user-id(user-id) => { root.revoked = user-id; }
    }
}

// Lookup, whose own line says what a search found or why it failed.
export component LookupProbe inherits Window {
    in-out property <string> status;

    width: 620px;
    height: 720px;

    LookupDialog {
        width: 100%;
        height: 100%;
        status: root.status;
    }
}

// The status line at the width of the smallest window the app allows.
export component StatusProbe inherits Window {
    in-out property <string> text;
    in-out property <bool> announce: true;

    width: 860px;
    height: 200px;

    VerticalLayout {
        alignment: end;
        StatusBar {
            text: root.text;
            announce: root.announce;
        }
    }
}

// The details pane's revocation notice, at the width the pane gives it.
export component RevocationBannerProbe inherits Window {
    in-out property <string> reason: "Replaced by a newer key";
    in-out property <string> note;

    width: 288px;
    height: 300px;

    VerticalLayout {
        alignment: start;
        RevocationBanner {
            reason: root.reason;
            note: root.note;
        }
    }
}
