// Test-only harness: one passphrase Field and one ordinary Field, so what the
// accessibility tree publishes can be inspected from a Rust test. Not part of
// the application.
import { Field, Btn, Check, Select, FieldRow } from "../widgets.slint";
import { SignEncryptDialog, CertifyDialog, NotepadDialog } from "../dialogs.slint";
import { KeygenDialog, DecryptVerifyDialog, RevokeDialog, LifecycleDialog } from "../dialogs.slint";
import { RecipientRow, UserIdRow } from "../types.slint";

export component FieldProbe inherits Window {
    in-out property <string> secret-text <=> pass-field.text;
    in-out property <string> plain-text <=> plain-field.text;

    width: 240px;
    height: 80px;

    VerticalLayout {
        pass-field := Field {
            placeholder: "Passphrase";
            secret: true;
        }
        plain-field := Field {
            placeholder: "Search";
        }
    }
}

// The interactive controls, so a test can ask what assistive technology would
// be told about each and whether it can operate them.
export component ControlProbe inherits Window {
    in-out property <int> clicks: 0;
    in-out property <int> toggles: 0;
    in-out property <int> copies: 0;
    // State the controls actually carry, so a test can move it and check the
    // accessibility tree followed. Without these the probe never changed state
    // and the tree's checked/value assertions were satisfied by the defaults —
    // they would have held against a hardcoded binding just as well.
    in-out property <bool> encrypt: false;
    in-out property <int> standard: 0;

    width: 500px;
    height: 400px;

    VerticalLayout {
        Btn { text: "Save"; clicked => { root.clicks += 1; } }
        // Icon-only and destructive: the case that used to announce nothing.
        Btn { label: "Revoke user ID alice"; clicked => { root.clicks += 1; } }
        Check {
            text: "Encrypt";
            checked: root.encrypt;
            toggled => {
                root.toggles += 1;
                root.encrypt = !root.encrypt;
            }
        }
        Select {
            label: "Standard";
            model: ["Modern", "Compatible"];
            current: root.standard;
            changed(index) => { root.standard = index; }
        }
        FieldRow {
            label: "Fingerprint";
            value: "ABCD 1234";
            mono: true;
            copyable: true;
            copy => { root.copies += 1; }
        }
        FieldRow { label: "Algorithm"; value: "Ed25519"; }
    }
}

// The two selection lists, driven through the real dialogs rather than through
// a copy of their markup here: a probe that reproduced the rows would go on
// passing after the shipped rows lost their accessibility again.
export component SelectionProbe inherits Window {
    in-out property <[RecipientRow]> recipients;
    in-out property <int> toggled-recipient: -1;

    width: 620px;
    height: 720px;

    SignEncryptDialog {
        width: 100%;
        height: 100%;
        input-path: "/tmp/message.txt";
        recipients: root.recipients;
        toggle-recipient(index) => { root.toggled-recipient = index; }
    }
}

export component CertifyProbe inherits Window {
    in-out property <[UserIdRow]> user-ids;
    in-out property <int> toggled-user-id: -1;

    width: 620px;
    height: 720px;

    CertifyDialog {
        width: 100%;
        height: 100%;
        target-name: "Alice";
        user-ids: root.user-ids;
        toggle-user-id(index) => { root.toggled-user-id = index; }
    }
}

// The notepad carries a third copy of the recipient row, behind its own filter.
export component NotepadProbe inherits Window {
    in-out property <[RecipientRow]> recipients;
    in-out property <int> toggled-recipient: -1;

    width: 620px;
    height: 720px;

    NotepadDialog {
        width: 100%;
        height: 100%;
        recipients: root.recipients;
        toggle-recipient(index) => { root.toggled-recipient = index; }
    }
}

// The four passphrase-bearing dialogs the probes above do not reach. The other
// five passphrase fields live in SignEncryptDialog, CertifyDialog and
// NotepadDialog, which the selection probes already instantiate.
export component KeygenProbe inherits Window {
    width: 620px;
    height: 720px;
    KeygenDialog { width: 100%; height: 100%; }
}

export component DecryptProbe inherits Window {
    width: 620px;
    height: 720px;
    // The passphrase field is conditional on a file having been chosen.
    DecryptVerifyDialog { width: 100%; height: 100%; input-path: "/tmp/message.txt"; }
}

export component RevokeProbe inherits Window {
    width: 620px;
    height: 720px;
    RevokeDialog { width: 100%; height: 100%; target-name: "Alice"; }
}

export component LifecycleProbe inherits Window {
    width: 620px;
    height: 720px;
    // Every mode but publish carries the passphrase field.
    LifecycleDialog { width: 100%; height: 100%; mode: 0; target: "Alice"; }
}
